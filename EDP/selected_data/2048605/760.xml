er höhern Ausbildung. §. 146 — 152. | Dritter Abschnitt. Von den äuſsern Verhältnissen des Geistes. | Erstes Capitel. Von der Verbindung zwischen Leib und Seele. §. 153 — 159. | Zweytes Capitel. Von denjenigen Geisteszuständen, worauf der Leib einen bemerkbaren Einfluſs hat. §. 160 — 168. | Schluſs. |</dcterms:tableOfContents><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2048605/data_item_bbaw_dta_17174"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/2048605/data_item_bbaw_dta_17174"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2048605/data_item_bbaw_dta_17174"><dc:creator rdf:resource="http://data.europeana.eu/agent/145478"></dc:creator><dc:description xml:lang="de">SBB-PK, Nn 3042-2&amp;lt;a&amp;gt; R</dc:description><dc:description xml:lang="en">SBB-PK, Nn 3042-2 &amp; lt; a &amp; gt; R</dc:description><dc:publisher xml:lang="de">Unzer</dc:publisher><dc:publisher xml:lang="en">Unzer</dc:publisher><dc:rights xml:lang="de">Distributed under the Creative Commons Attribution-NonCommercial 3.0 Unported License.</dc:rights><dc:rights xml:lang="en">Distributed under the Creative Commons Attribution-NonCommercial 3.0 Unported License.</dc:rights><dc:subject xml:lang="de">Medizin</dc:subject><dc:subject rdf:resource="http://data.europeana.eu/concept/154"></dc:subject><dc:subject rdf:resource="http://data.europeana.eu/concept/131"></dc:subject><dc:subject xml:lang="en">Medicine</dc:subject><dc:title xml:lang="en">Zweyter, analytical Theil</dc:title><dc:type xml:lang="de">Fachtext</dc:type><dc:type xml:lang="de">Wissenschaft</dc:type><dc:type rdf:resource="http://data.europeana.eu/concept/6"></dc:type><dc:type xml:lang="en">Subject text</dc:type><dc:type xml:lang="en">Science</dc:type><dcterms:alternative xml:lang="en">Herbart, Johann Friedrich: Psychology as a science. Bd. 2. Königsberg, 1825.</dcterms:alternative><dcterms:extent xml: