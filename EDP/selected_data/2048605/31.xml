unto de reglas, normas o protocolos que tiene como objetivo obtener un resultado determinado</skos:note><skos:note xml:lang="cs">Způsob nebo metoda, kterou je prováděna nějaká aktivita</skos:note><skos:note xml:lang="eu">Jarduera burutzeko prozeduretako bakoitza</skos:note><skos:note xml:lang="pl">Suma umiejętości, sposobów i procesów pozwalających na osiągnięcie celu</skos:note><skos:note xml:lang="ca">Mètode pel qual es fa una activitat</skos:note><skos:note xml:lang="nl">Manier of methode waarop een activiteit uitgevoerd wordt</skos:note><skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2695280"/><skos:exactMatch rdf:resource="https://d-nb.info/gnd/4059205-4"/><skos:exactMatch rdf:resource="http://id.loc.gov/authorities/names/sh87003681"/><skos:exactMatch rdf:resource="http://id.ndl.go.jp/auth/ndlna/00562503"/><skos:exactMatch rdf:resource="http://purl.org/bncf/tid/1981"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300138082"/><skos:exactMatch rdf:resource="http://g.co/kg/g/122152pm"/><skos:exactMatch rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10366"/><skos:exactMatch rdf:resource="http://uri.gbv.de/terminology/bk/50"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Technique_(method)"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/2048605/data_item_bbaw_dta_16482"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2048605/data_item_bbaw_dta_16482"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502123"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.deutschestextarchiv.de/soemmerring_telegraphen_1811"/><edm:object rdf:resource="http://media.dwds.de/dta/images/soemmerring_telegraphen_1811/soemmerring_telegraphen_1811_0007_1600px.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671099"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/4.0/"/