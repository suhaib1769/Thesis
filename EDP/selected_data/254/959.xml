<?xml version="1.0" encoding="UTF-8" standalone="yes"?><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:edm="http://www.europeana.eu/schemas/edm/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:wgs84_pos="http://www.w3.org/2003/01/geo/wgs84_pos#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:rdaGr2="http://rdvocab.info/ElementsGr2/" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:ebucore="http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#" xmlns:doap="http://usefulinc.com/ns/doap#" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:cc="http://creativecommons.org/ns#" xmlns:ore="http://www.openarchives.org/ore/terms/" xmlns:svcs="http://rdfs.org/sioc/services#" xmlns:oa="http://www.w3.org/ns/oa#" xmlns:dqv="http://www.w3.org/ns/dqv#"><edm:ProvidedCHO rdf:about="http://data.europeana.eu/item/254/EA_set8_82098"/><edm:WebResource rdf:about="https://www.eheritage.si/AN3DP/00410_EJKVTFJXULZFQDGRQTUD.jpg"><ebucore:hasMimeType>image/jpeg</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">14025</ebucore:fileByteSize><ebucore:width rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">327</ebucore:width><ebucore:height rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">254</ebucore:height><edm:hasColorSpace>grayscale</edm:hasColorSpace><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#2F4F4F</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#556B2F</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#BDB76B</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#000000</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FFFFFF</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#D3D3D3</edm:componentColor><ebucore:orientation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">landscape</ebucore:orientation></edm:WebResource><edm:WebResource rdf:about="http://ea-and.civitat.com/?id=EA-AND-82098"><ebucore:hasMimeType>text/html</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">9280</ebucore:fileByteSize></edm:WebResource><edm:WebResource rdf:about="https://sketchfab.com/models/48937018eaa54f89ab6a5ba10a43eb7e/embed?autostart=1"><dc:creator xml:lang="sl">Muzej in galerije mesta Ljubljane</dc:creator><dc:format>gltf</dc:format><dc:rights xml:lang="sl">copyright: Muzej in galerije mesta Ljubljane</dc:rights><rdf:type rdf:resource="http://www.europeana.eu/schemas/edm/FullTextResource"/><ebucore:hasMimeType>text/html</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">102574</ebucore:fileByteSize></edm:WebResource><edm:Place rdf:about="EA-set8-82098#place"><wgs84_pos:lat>46.046894</wgs84_pos:lat><wgs84_pos:long>14.50417</wgs84_pos:long><skos:prefLabel xml:lang="sl">Ljubljana, Slovenija</skos:prefLabel></edm:Place><edm:TimeSpan rdf:about="EA-set8-82098#time"><skos:prefLabel>Art Nouveau</skos:prefLabel><edm:begin>1890</edm:begin><edm:end>1910</edm:end><owl:sameAs rdf:resource="http://vocab.getty.edu/page/aat/300021430"/></edm:TimeSpan><skos:Concept rdf:about="http://vocab.getty.edu/aat/300265424"><skos:altLabel xml:lang="en">FDM</skos:altLabel><skos:altLabel xml:lang="en">modeling, fused deposition</skos:altLabel><skos:altLabel xml:lang="es">modelado</skos:altLabel><skos:prefLabel xml:lang="zh-hant">熔融擠製成型法</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-wadegile">jung jung chi chih ch'eng hsing fa</skos:prefLabel><skos:prefLabel xml:lang="en">fused deposition modeling</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-hanyu">róng róng jǐ zhì chéng xíng fǎ</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-notone">rong rong ji zhi cheng xing fa</skos:prefLabel><skos:prefLabel xml:lang="es">modelado fundido</skos:prefLabel><skos:prefLabel xml:lang="nl">fused deposition modeling</skos:prefLabel><skos:note xml:lang="zh-hant">為快速成型技術中的一種，成型的方式為將已加熱的熱塑性細絲線，逐漸地擠壓至平台上，創造出一個物件之中的各個橫斷面，並且於最終從塑膠材料中製作出一個3D立體物件的原型。</skos:note><skos:note xml:lang="en">Type of rapid prototyping whereby filaments of heated thermoplastic are gradually extruded onto a platform, creating cross-sections of an object and eventually creating a 3-D object prototype out of plastic.</skos:note><skos:note xml:lang="es">Tipo de prototipo rápido termoplástico , creando secciones representativas de un objeto y eventualmente un prototipo tridimensional del objeto fuera del plástico.</skos:note><skos:note xml:lang="nl">Vorm van rapid prototyping met geleidelijke extrusie van draadvormig thermoplastisch kunststof op een platform, waardoor dwarsdoorsneden van een object worden gecreëerd en uiteindelijk een driedimensionaal prototype van kunststof resulteert.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300265423"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300021313"><skos:prefLabel xml:lang="de">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="zh-hant">青年風格</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-wadegile">ch'ing nien feng ko</skos:prefLabel><skos:prefLabel xml:lang="en">Jugendstil (German, Austrian Art Nouveau)</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-hanyu">qīng nián fēng gé</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-notone">qing nian feng ge</skos:prefLabel><skos:prefLabel xml:lang="nl">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="es">Jugendstil</skos:prefLabel><skos:note xml:lang="zh-hant">是指德國和奧地利的新藝術風格，以1896年的青年（Jugend）雜誌命名。此種風格與比利時及法國的新藝術風格不同之處，在於對裝飾的運用較為節制。青年風格是以比較拘謹的美學取代其他新藝術風格的生氣蓬勃和自然主義，師從自然，但無法直接辨識出其取材的自然形狀。</skos:note><skos:note xml:lang="en">Refers to the German and Austrian variation of Art Nouveau, named after the magazine "Jugend" that had been published in Munich since 1896. The style differs from Belgian and French Art Nouveau by a more restrained use of decoration. Jugendstil replaced the exuberance and naturalism of other Art Nouveau styles with a comparatively subdued aesthetic that was often almost unrecognizably, or not at all derived from nature.</skos:note><skos:note xml:lang="nl">Verwijst naar de Duitse en Oostenrijkse vorm van de Art Nouveau, vernoemd naar het tijdschrift Jugend in 1896. De stijl wordt gekenmerkt door een meer ingetogen gebruik van decoratie dan de Belgische en Franse Art Nouveau.</skos:note><skos:note xml:lang="es">Se refiere a la forma alemana y austríaca de Art Nouveau, nombrado después de la revista Jugend en 1896. El estilo se caracteriza por un uso más moderado de la decoración que el Art Nouveau belga y francés.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300021430"/><skos:broader rdf:resource="http://vocab.getty.edu/aat/300020656"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300008063"><skos:altLabel xml:lang="pt">edifício histórico</skos:altLabel><skos:altLabel xml:lang="en">historic building</skos:altLabel><skos:altLabel xml:lang="en">buildings, historic</skos:altLabel><skos:altLabel xml:lang="en">heritage buildings</skos:altLabel><skos:altLabel xml:lang="en">heritage building</skos:altLabel><skos:altLabel xml:lang="nl">historisch gebouw</skos:altLabel><skos:altLabel xml:lang="es">edificio histórico</skos:altLabel><skos:prefLabel xml:lang="pt">edifícios históricos</skos:prefLabel><skos:prefLabel xml:lang="en">historic buildings</skos:prefLabel><skos:prefLabel xml:lang="nl">historische gebouwen</skos:prefLabel><skos:prefLabel xml:lang="es">edificios históricos</skos:prefLabel><skos:note xml:lang="pt">Edifícios significativos na história da arquitetura, que incorporam características arquitetônicas significativas ou que desempenharam papéis históricos significativos no desenvolvimento cultural ou social local; pode ou não ser oficialmente designado. Para edifícios abandonados, mas não considerados necessariamente históricos, use "edifícios abandonados".</skos:note><skos:note xml:lang="en">Buildings that are significant in the history of architecture, that incorporate significant architectural features, or that played significant historic roles in local cultural or social development; may or may not be officially designated. For buildings that are abandoned but not considered necessarily historic, use "abandoned buildings."</skos:note><skos:note xml:lang="es">Edificio que es significativo desde el punto de vista de la historia de la arquitectura, que incorpora características arquitectónicas importantes o que juega un papel histórico relevante en el desarrollo local cultural o social. Puede o no estar diseñado oficialmente.</skos:note><skos:note xml:lang="nl">Wordt gebruikt voor gebouwen die van belang zijn in de geschiedenis van de architectuur, die belangrijke architectonische elementen bevatten of die een belangrijke historische rol hebben gespeeld in de plaatselijke culturele of sociale ontwikkeling; kan al of niet officieel zijn aangewezen.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300004790"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/254/EA_set8_82098"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/254/EA_set8_82098"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510556"></edm:dataProvider><edm:isShownAt rdf:resource="http://ea-and.civitat.com/?id=EA-AND-82098"/><edm:isShownBy rdf:resource="https://sketchfab.com/models/48937018eaa54f89ab6a5ba10a43eb7e/embed?autostart=1"/><edm:object rdf:resource="https://www.eheritage.si/AN3DP/00410_EJKVTFJXULZFQDGRQTUD.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671084"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc-nd/4.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/254/EA_set8_82098"><dc:date xml:lang="en">Start 20. centuries</dc:date><dc:date xml:lang="sl">začetek 20. stoletja</dc:date><dc:identifier>EA-set8-82098</dc:identifier><dc:language>slv</dc:language><dcterms:spatial xml:lang="sl">EA-set8-82098#place</dcterms:spatial><dcterms:temporal xml:lang="sl">EA-set8-82098#time</dcterms:temporal><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/254/EA_set8_82098"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/254/EA_set8_82098"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/provider/254/EA_set8_82098"/><edm:type>3D</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/254/EA_set8_82098"><dc:creator xml:lang="sl">Pirkenhammer, Austria</dc:creator><dc:creator xml:lang="sl">Muzej in galerije mesta Ljubljane</dc:creator><dc:date>začetek 20. stoletja</dc:date><dc:description xml:lang="sl">3D model doze porcelanastega umivalnega seta v secesijskem slogu, inventarna št.: 510:LJU;0015094</dc:description><dc:identifier>EA-AND-82098</dc:identifier><dc:language xml:lang="en">Slovenian</dc:language><dc:subject rdf:resource="http://vocab.getty.edu/aat/300021313"></dc:subject><dc:subject rdf:resource="http://vocab.getty.edu/aat/300008063"></dc:subject><dc:subject rdf:resource="http://vocab.getty.edu/aat/300265424"></dc:subject><dc:title xml:lang="sl">Umivalni set - doza</dc:title><dc:type xml:lang="en">3D</dc:type><dcterms:isPartOf xml:lang="en">Europeana Archaeology</dcterms:isPartOf><dcterms:spatial>EA-set8-82098#place</dcterms:spatial><dcterms:temporal>EA-set8-82098#time</dcterms:temporal><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/254/EA_set8_82098"/>