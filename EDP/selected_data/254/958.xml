<?xml version="1.0" encoding="UTF-8" standalone="yes"?><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:edm="http://www.europeana.eu/schemas/edm/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:wgs84_pos="http://www.w3.org/2003/01/geo/wgs84_pos#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:rdaGr2="http://rdvocab.info/ElementsGr2/" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:ebucore="http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#" xmlns:doap="http://usefulinc.com/ns/doap#" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:cc="http://creativecommons.org/ns#" xmlns:ore="http://www.openarchives.org/ore/terms/" xmlns:svcs="http://rdfs.org/sioc/services#" xmlns:oa="http://www.w3.org/ns/oa#" xmlns:dqv="http://www.w3.org/ns/dqv#"><edm:ProvidedCHO rdf:about="http://data.europeana.eu/item/254/EA_set8_82097"/><edm:WebResource rdf:about="http://ea-and.civitat.com/?id=EA-AND-82097"><ebucore:hasMimeType>text/html</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">9280</ebucore:fileByteSize></edm:WebResource><edm:WebResource rdf:about="https://www.eheritage.si/AN3DP/00411_AQLGDTCTIWVGXIBMYJSF.jpg"><ebucore:hasMimeType>image/jpeg</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">11067</ebucore:fileByteSize><ebucore:width rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">327</ebucore:width><ebucore:height rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">253</ebucore:height><edm:hasColorSpace>grayscale</edm:hasColorSpace><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#696969</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#A9A9A9</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#BDB76B</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#DCDCDC</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FFFAFA</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#2F4F4F</edm:componentColor><ebucore:orientation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">landscape</ebucore:orientation></edm:WebResource><edm:WebResource rdf:about="https://sketchfab.com/models/17fe294df8f94c37b207ef25b390dc99/embed?autostart=1"><dc:creator xml:lang="sl">Muzej in galerije mesta Ljubljane</dc:creator><dc:format>gltf</dc:format><dc:rights xml:lang="sl">copyright: Muzej in galerije mesta Ljubljane</dc:rights><rdf:type rdf:resource="http://www.europeana.eu/schemas/edm/FullTextResource"/><ebucore:hasMimeType>text/html</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">102140</ebucore:fileByteSize></edm:WebResource><edm:Place rdf:about="EA-set8-82097#place"><wgs84_pos:lat>46.046894</wgs84_pos:lat><wgs84_pos:long>14.50417</wgs84_pos:long><skos:prefLabel xml:lang="sl">Ljubljana, Slovenija</skos:prefLabel></edm:Place><edm:TimeSpan rdf:about="EA-set8-82097#time"><skos:prefLabel>Art Nouveau</skos:prefLabel><edm:begin>1890</edm:begin><edm:end>1910</edm:end><owl:sameAs rdf:resource="http://vocab.getty.edu/page/aat/300021430"/></edm:TimeSpan><skos:Concept rdf:about="http://vocab.getty.edu/aat/300265425"><skos:altLabel xml:lang="zh-hant">光固化立體造型術</skos:altLabel><skos:altLabel xml:lang="zh-hant">光固化成形法</skos:altLabel><skos:altLabel xml:lang="en">SLA</skos:altLabel><skos:altLabel xml:lang="en">SL (stereolithography)</skos:altLabel><skos:altLabel xml:lang="en">STL</skos:altLabel><skos:altLabel xml:lang="es">prototipo</skos:altLabel><skos:prefLabel xml:lang="zh-hant">雷射光合高分子成型</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-wadegile">lei she kuang ho kao fen tzu ch'eng hsing</skos:prefLabel><skos:prefLabel xml:lang="en">stereolithography</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-hanyu">léi shè guāng hé gāo fēn zǐ chéng xíng</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-notone">lei she guang he gao fen zi cheng xing</skos:prefLabel><skos:prefLabel xml:lang="es">estercolitografia</skos:prefLabel><skos:prefLabel xml:lang="nl">stereolithografie</skos:prefLabel><skos:note xml:lang="zh-hant">為快速成型技術的製作過程，從大量的感光性樹脂之中，使用紫外線雷射製作出物件的橫斷面，以建構出3D立體物件。此樹脂聚合物暴露於紫外線下時即可固化。此種製作過程發展於西元1986年間，且一般而言，以此項過程製造出的組件質地相當脆弱。</skos:note><skos:note xml:lang="en">An an early, widely used 3-D printing technology. It is a process that builds 3-D objects by converting liquid materials into solid parts by curing them using a light source, which causes chains of molecules to link, forming polymers. The process is used for creating models, prototypes, patterns, and production parts. A typical method uses a UV laser to create cross-sections of the object within a vat of liquid photopolymer. The process was first developed in 1986. The process is valued to create accurate parts with repeatable dimensions; applications include engineering assemblies, jewelry casting, and dental repairs.</skos:note><skos:note xml:lang="es">Proceso de prototipo rápido que construye objetos tridimensionales usando un laser UV para crear las partes representativas del objeto. Los polímeros solidifican cuando están expuestos a la luz UV. El proceso fue desarrollado en 1986, y las piezas creadas por este proceso son generalmente frágiles.</skos:note><skos:note xml:lang="nl">In 1986 ontwikkeld rapid prototyping-proces waarbij driedimensionale objecten worden geconstrueerd door middel van een UV-laser die dwarsdoorsneden van het object binnen een vat met vloeibare fotopolymeren opbouwt. Bij blootstelling aan UV-licht harden de polymeren uit. De met dit procedé vervaardigde delen zijn doorgaans nogal kwetsbaar.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300391465"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/><skos:related rdf:resource="http://vocab.getty.edu/aat/300419431"/><skos:related rdf:resource="http://vocab.getty.edu/aat/300265423"/><skos:related rdf:resource="http://vocab.getty.edu/aat/300220344"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300021313"><skos:prefLabel xml:lang="de">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="zh-hant">青年風格</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-wadegile">ch'ing nien feng ko</skos:prefLabel><skos:prefLabel xml:lang="en">Jugendstil (German, Austrian Art Nouveau)</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-hanyu">qīng nián fēng gé</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-notone">qing nian feng ge</skos:prefLabel><skos:prefLabel xml:lang="nl">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="es">Jugendstil</skos:prefLabel><skos:note xml:lang="zh-hant">是指德國和奧地利的新藝術風格，以1896年的青年（Jugend）雜誌命名。此種風格與比利時及法國的新藝術風格不同之處，在於對裝飾的運用較為節制。青年風格是以比較拘謹的美學取代其他新藝術風格的生氣蓬勃和自然主義，師從自然，但無法直接辨識出其取材的自然形狀。</skos:note><skos:note xml:lang="en">Refers to the German and Austrian variation of Art Nouveau, named after the magazine "Jugend" that had been published in Munich since 1896. The style differs from Belgian and French Art Nouveau by a more restrained use of decoration. Jugendstil replaced the exuberance and naturalism of other Art Nouveau styles with a comparatively subdued aesthetic that was often almost unrecognizably, or not at all derived from nature.</skos:note><skos:note xml:lang="nl">Verwijst naar de Duitse en Oostenrijkse vorm van de Art Nouveau, vernoemd naar het tijdschrift Jugend in 1896. De stijl wordt gekenmerkt door een meer ingetogen gebruik van decoratie dan de Belgische en Franse Art Nouveau.</skos:note><skos:note xml:lang="es">Se refiere a la forma alemana y austríaca de Art Nouveau, nombrado después de la revista Jugend en 1896. El estilo se caracteriza por un uso más moderado de la decoración que el Art Nouveau belga y francés.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300021430"/><skos:broader rdf:resource="http://vocab.getty.edu/aat/300020656"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300008063"><skos:altLabel xml:lang="pt">edifício histórico</skos:altLabel><skos:altLabel xml:lang="en">historic building</skos:altLabel><skos:altLabel xml:lang="en">buildings, historic</skos:altLabel><skos:altLabel xml:lang="en">heritage buildings</skos:altLabel><skos:altLabel xml:lang="en">heritage building</skos:altLabel><skos:altLabel xml:lang="nl">historisch gebouw</skos:altLabel><skos:altLabel xml:lang="es">edificio histórico</skos:altLabel><skos:prefLabel xml:lang="pt">edifícios históricos</skos:prefLabel><skos:prefLabel xml:lang="en">historic buildings</skos:prefLabel><skos:prefLabel xml:lang="nl">historische gebouwen</skos:prefLabel><skos:prefLabel xml:lang="es">edificios históricos</skos:prefLabel><skos:note xml:lang="pt">Edifícios significativos na história da arquitetura, que incorporam características arquitetônicas significativas ou que desempenharam papéis históricos significativos no desenvolvimento cultural ou social local; pode ou não ser oficialmente designado. Para edifícios abandonados, mas não considerados necessariamente históricos, use "edifícios abandonados".</skos:note><skos:note xml:lang="en">Buildings that are significant in the history of architecture, that incorporate significant architectural features, or that played significant historic roles in local cultural or social development; may or may not be officially designated. For buildings that are abandoned but not considered necessarily historic, use "abandoned buildings."</skos:note><skos:note xml:lang="es">Edificio que es significativo desde el punto de vista de la historia de la arquitectura, que incorpora características arquitectónicas importantes o que juega un papel histórico relevante en el desarrollo local cultural o social. Puede o no estar diseñado oficialmente.</skos:note><skos:note xml:lang="nl">Wordt gebruikt voor gebouwen die van belang zijn in de geschiedenis van de architectuur, die belangrijke architectonische elementen bevatten of die een belangrijke historische rol hebben gespeeld in de plaatselijke culturele of sociale ontwikkeling; kan al of niet officieel zijn aangewezen.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300004790"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/254/EA_set8_82097"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/254/EA_set8_82097"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510556"></edm:dataProvider><edm:isShownAt rdf:resource="http://ea-and.civitat.com/?id=EA-AND-82097"/><edm:isShownBy rdf:resource="https://sketchfab.com/models/17fe294df8f94c37b207ef25b390dc99/embed?autostart=1"/><edm:object rdf:resource="https://www.eheritage.si/AN3DP/00411_AQLGDTCTIWVGXIBMYJSF.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671084"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc-nd/4.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/254/EA_set8_82097"><dc:date xml:lang="en">Start 20. centuries</dc:date><dc:date xml:lang="sl">začetek 20. stoletja</dc:date><dc:identifier>EA-set8-82097</dc:identifier><dc:language>slv</dc:language><dcterms:spatial xml:lang="en">EA-set8-82097#place</dcterms:spatial><dcterms:temporal xml:lang="sl">EA-set8-82097#time</dcterms:temporal><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/254/EA_set8_82097"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/254/EA_set8_82097"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/provider/254/EA_set8_82097"/><edm:type>3D</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/prov