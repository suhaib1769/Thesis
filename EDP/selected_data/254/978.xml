<?xml version="1.0" encoding="UTF-8" standalone="yes"?><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:edm="http://www.europeana.eu/schemas/edm/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:wgs84_pos="http://www.w3.org/2003/01/geo/wgs84_pos#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:rdaGr2="http://rdvocab.info/ElementsGr2/" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:ebucore="http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#" xmlns:doap="http://usefulinc.com/ns/doap#" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:cc="http://creativecommons.org/ns#" xmlns:ore="http://www.openarchives.org/ore/terms/" xmlns:svcs="http://rdfs.org/sioc/services#" xmlns:oa="http://www.w3.org/ns/oa#" xmlns:dqv="http://www.w3.org/ns/dqv#"><edm:ProvidedCHO rdf:about="http://data.europeana.eu/item/254/EA_set8_82631"/><edm:WebResource rdf:about="https://sketchfab.com/models/dc519964bf144025a78fbc8d6941f6ad/embed?autostart=1"><dc:creator xml:lang="sl">Muzej in galerije mesta Ljubljane</dc:creator><dc:format>gltf</dc:format><dc:rights xml:lang="sl">copyright: Muzej in galerije mesta Ljubljane</dc:rights><rdf:type rdf:resource="http://www.europeana.eu/schemas/edm/FullTextResource"/><ebucore:hasMimeType>text/html</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">99475</ebucore:fileByteSize></edm:WebResource><edm:WebResource rdf:about="https://www.eheritage.si/AN3DP/00417_GTBDVBMJYFJSRPSILFSG.jpg"><ebucore:hasMimeType>image/jpeg</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">10631</ebucore:fileByteSize><ebucore:width rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">325</ebucore:width><ebucore:height rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">254</ebucore:height><edm:hasColorSpace>grayscale</edm:hasColorSpace><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FAF0E6</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#A9A9A9</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#808080</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#E6E6FA</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FFF5EE</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FFFFFF</edm:componentColor><ebucore:orientation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">landscape</ebucore:orientation></edm:WebResource><edm:WebResource rdf:about="http://ea-and.civitat.com/?id=EA-AND-82631"><ebucore:hasMimeType>text/html</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">9280</ebucore:fileByteSize></edm:WebResource><edm:Place rdf:about="EA-set8-82631#place"><wgs84_pos:lat>46.046894</wgs84_pos:lat><wgs84_pos:long>14.50417</wgs84_pos:long><skos:prefLabel xml:lang="sl">Ljubljana, Slovenija</skos:prefLabel></edm:Place><edm:TimeSpan rdf:about="EA-set8-82631#time"><skos:prefLabel>Art Nouveau</skos:prefLabel><edm:begin>1890</edm:begin><edm:end>1910</edm:end><owl:sameAs rdf:resource="http://vocab.getty.edu/page/aat/300021430"/></edm:TimeSpan><skos:Concept rdf:about="http://vocab.getty.edu/aat/300265447"><skos:altLabel xml:lang="en">twentyfourmo</skos:altLabel><skos:altLabel xml:lang="en">24mo</skos:altLabel><skos:altLabel xml:lang="en">vigesimo-quarto</skos:altLabel><skos:altLabel xml:lang="en">vincestmo-quarto</skos:altLabel><skos:prefLabel xml:lang="zh-hant">二十四開本</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-wadegile">erh shih ssu k'ai pen</skos:prefLabel><skos:prefLabel xml:lang="en">twenty-fourmo</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-hanyu">èr shí sì kāi běn</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-notone">er shi si kai ben</skos:prefLabel><skos:prefLabel xml:lang="es">en 24.º (formato libro)</skos:prefLabel><skos:prefLabel xml:lang="nl">vierentwintiger formaat</skos:prefLabel><skos:note xml:lang="zh-hant">具有24開或48頁面的書籍規格。最常見的製作方法是將兩張紙以兩個平行摺的方式摺成三等分。接下來作一個直角摺，一個平行摺，然後將第二張紙塞入第一張紙內。</skos:note><skos:note xml:lang="en">Book format which holds 24 leaves or 48 pages. The most common method used to produce a twenty-fourmo is to fold two separate sheets with two parallel folds in thirds. This is followed by a right angle fold, a parallel fold, and then inserting the second sheet within the first.</skos:note><skos:note xml:lang="es">Formato de libro que abarca 24 hojas o 48 páginas. el método más común empleado para producir este formato es doblar dos pliegos separados con dos pliegues paralelos en tercios. Luego con un doblez de ángulo recto, un pliegue en paralelo y después insertar este segundo pliego dentro del primero.</skos:note><skos:note xml:lang="nl">Boekformaat met 24 vellen of 48 pagina's. De gebruikelijkste methode voor het creëren van een vierentwintiger formaat is door twee afzonderlijke vellen papier met twee parallelle vouwen in drieën te vouwen. Vervolgens wordt het geheel eerst overdwars en daarna parallel gevouwen, waarna het tweede vel papier in het eerste wordt geschoven.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300266038"/><skos:broader rdf:resource="http://vocab.getty.edu/aat/300266035"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300021313"><skos:prefLabel xml:lang="de">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="zh-hant">青年風格</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-wadegile">ch'ing nien feng ko</skos:prefLabel><skos:prefLabel xml:lang="en">Jugendstil (German, Austrian Art Nouveau)</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-hanyu">qīng nián fēng gé</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-notone">qing nian feng ge</skos:prefLabel><skos:prefLabel xml:lang="nl">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="es">Jugendstil</skos:prefLabel><skos:note xml:lang="zh-hant">是指德國和奧地利的新藝術風格，以1896年的青年（Jugend）雜誌命名。此種風格與比利時及法國的新藝術風格不同之處，在於對裝飾的運用較為節制。青年風格是以比較拘謹的美學取代其他新藝術風格的生氣蓬勃和自然主義，師從自然，但無法直接辨識出其取材的自然形狀。</skos:note><skos:note xml:lang="en">Refers to the German and Austrian variation of Art Nouveau, named after the magazine "Jugend" that had been published in Munich since 1896. The style differs from Belgian and French Art Nouveau by a more restrained use of decoration. Jugendstil replaced the exuberance and naturalism of other Art Nouveau styles with a comparatively subdued aesthetic that was often almost unrecognizably, or not at all derived from nature.</skos:note><skos:note xml:lang="nl">Verwijst naar de Duitse en Oostenrijkse vorm van de Art Nouveau, vernoemd naar het tijdschrift Jugend in 1896. De stijl wordt gekenmerkt door een meer ingetogen gebruik van decoratie dan de Belgische en Franse Art Nouveau.</skos:note><skos:note xml:lang="es">Se refiere a la forma alemana y austríaca de Art Nouveau, nombrado después de la revista Jugend en 1896. El estilo se caracteriza por un uso más moderado de la decoración que el Art Nouveau belga y francés.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300021430"/><skos:broader rdf:resource="http://vocab.getty.edu/aat/300020656"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300008063"><skos:altLabel xml:lang="pt">edifício histórico</skos:altLabel><skos:altLabel xml:lang="en">historic building</skos:altLabel><skos:altLabel xml:lang="en">buildings, historic</skos:altLabel><skos:altLabel xml:lang="en">heritage buildings</skos:altLabel><skos:altLabel xml:lang="en">heritage building</skos:altLabel><skos:altLabel xml:lang="nl">historisch gebouw</skos:altLabel><skos:altLabel xml:lang="es">edificio histórico</skos:altLabel><skos:prefLabel xml:lang="pt">edifícios históricos</skos:prefLabel><skos:prefLabel xml:lang="en">historic buildings</skos:prefLabel><skos:prefLabel xml:lang="nl">historische gebouwen</skos:prefLabel><skos:prefLabel xml:lang="es">edificios históricos</skos:prefLabel><skos:note xml:lang="pt">Edifícios significativos na história da arquitetura, que incorporam características arquitetônicas significativas ou que desempenharam papéis históricos significativos no desenvolvimento cultural ou social local; pode ou não ser oficialmente designado. Para edifícios abandonados, mas não considerados necessariamente históricos, use "edifícios abandonados".</skos:note><skos:note xml:lang="en">Buildings that are significant in the history of architecture, that incorporate significant architectural features, or that played significant historic roles in local cultural or social development; may or may not be officially designated. For buildings that are abandoned but not considered necessarily historic, use "abandoned buildings."</skos:note><skos:note xml:lang="es">Edificio que es significativo desde el punto de vista de la historia de la arquitectura, que incorpora características arquitectónicas importantes o que juega un papel histórico relevante en el desarrollo local cultural o social. Puede o no estar diseñado oficialmente.</skos:note><skos:note xml:lang="nl">Wordt gebruikt voor gebouwen die van belang zijn in de geschiedenis van de architectuur, die belangrijke architectonische elementen bevatten of die een belangrijke historische rol hebben gespeeld in de plaatselijke culturele of sociale ontwikkeling; kan al of niet officieel zijn aangewezen.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300004790"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/254/EA_set8_82631"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/254/EA_set8_82631"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organiza