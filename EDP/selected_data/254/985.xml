"http://www.w3.org/2001/XMLSchema#integer">327</ebucore:width><ebucore:height rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">253</ebucore:height><edm:hasColorSpace>grayscale</edm:hasColorSpace><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FFF0F5</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#F5F5F5</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FFFAFA</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FFF5EE</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#E6E6FA</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FAF0E6</edm:componentColor><ebucore:orientation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">landscape</ebucore:orientation></edm:WebResource><edm:Place rdf:about="EA-set8-82638#place"><wgs84_pos:lat>46.046894</wgs84_pos:lat><wgs84_pos:long>14.50417</wgs84_pos:long><skos:prefLabel xml:lang="sl">Ljubljana, Slovenija</skos:prefLabel></edm:Place><edm:TimeSpan rdf:about="EA-set8-82638#time"><skos:prefLabel>Art Nouveau</skos:prefLabel><edm:begin>1890</edm:begin><edm:end>1910</edm:end><owl:sameAs rdf:resource="http://vocab.getty.edu/page/aat/300021430"/></edm:TimeSpan><skos:Concept rdf:about="http://vocab.getty.edu/aat/300265448"><skos:altLabel xml:lang="en">48mo</skos:altLabel><skos:altLabel xml:lang="en">quadragesimo-octavo</skos:altLabel><skos:prefLabel xml:lang="zh-hant">四十八開本</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-wadegile">ssu shih pa k'ai pen</skos:prefLabel><skos:prefLabel xml:lang="en">forty-eightmo</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-hanyu">sì shí bā kāi běn</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-notone">si shi ba kai ben</skos:prefLabel><skos:prefLabel xml:lang="es">pliego doblado para formar 48 hojas</skos:prefLabel><skos:prefLabel xml:lang="nl">achtenveertiger formaat</skos:prefLabel><skos:note xml:lang="zh-hant">有48開或96頁面的書籍本規格。將一張紙作五次對摺產生32開，然後將半張紙摺成16開，塞入第一張紙內。</skos:note><skos:note xml:lang="en">Book format where a sheet is folded to form 48 leaves or 96 pages. It is formed by folding a sheet five times to form 32 leaves, and then a half sheet is folded to form 16 leaves, which is inserted into the former.</skos:note><skos:note xml:lang="es">Formato de libro en donde el pliego es doblado para formar 48 hojas y 96 páginas. Está formado al doblar un pliego cinco veces para obtener 32 hojas y un medio pliego es doblado para obtener 16 hojas el que es encajado en el primero.</skos:note><skos:note xml:lang="nl">Boekformaat waarbij een vel papier in 48 bladen of 96 pagina's wordt gevouwen. Dit gebeurt door een vel vijf keer te vouwen, waardoor 32 bladen ontstaan, en vervolgens een half vel te vouwen tot 16 bladen en dit in het eerste vel te schuiven.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300266038"/><skos:broader rdf:resource="http://vocab.getty.edu/aat/300266035"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300021313"><skos:prefLabel xml:lang="de">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="zh-hant">青年風格</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-wadegile">ch'ing nien feng ko</skos:prefLabel><skos:prefLabel xml:lang="en">Jugendstil (German, Austrian Art Nouveau)</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-hanyu">qīng nián fēng gé</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-notone">qing nian feng ge</skos:prefLabel><skos:prefLabel xml:lang="nl">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="es">Jugendstil</skos:prefLabel><skos:note xml:lang="zh-hant">是指德國和奧地利的新藝術風格，以1896年的青年（Jugend）雜誌命名。此種風格與比利時及法國的新藝術風格不同之處，在於對裝飾的運用較為節制。青年風格是以比較拘謹的美學取代其他新藝術風格的生氣蓬勃和自然主義，師從自然，但無法直接辨識出其取材的自然形狀。</skos:note><skos:note xml:lang="en">Refers to the German and Austrian variation of Art Nouveau, named after the magazine "Jugend" that had been published in Munich since 1896. The style differs from Belgian and French Art Nouveau by a more restrained use of decoration. Jugendstil replaced the exuberance and naturalism of other Art Nouveau styles with a comparatively subdued aesthetic that was often almost unrecognizably, or not at all derived from nature.</skos:note><skos:note xml:lang="nl">Verwijst naar de Duitse en Oostenrijkse vorm van de Art Nouveau, vernoemd naar het tijdschrift Jugend in 1896. De stijl wordt gekenmerkt door een meer ingetogen gebruik van decoratie dan de Belgische en Franse Art Nouveau.</skos:note><skos:note xml:lang="es">Se refiere a la forma alemana y austríaca de Art Nouveau, nombrado después de la revista Jugend en 1896. El estilo se caracteriza por un uso más moderado de la decoración que el Art Nouveau belga y francés.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300021430"/><skos:broader rdf:resource="http://vocab.getty.edu/aat/300020656"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300008063"><skos:altLabel xml:lang="pt">edifício histórico</skos:altLabel><skos:altLabel xml:lang="en">historic building</skos:altLabel><skos:altLabel xml:lang="en">buildings, historic</skos:altLabel><skos:altLabel xml:lang="en">heritage buildings</skos:altLabel><skos:altLabel xml:lang="en">heritage building</skos:altLabel><skos:altLabel xml:lang="nl">historisch gebouw</skos:altLabel><skos:altLabel xml:lang="es">edificio histórico</skos:altLabel><skos:prefLabel xml:lang="pt">edifícios históricos</skos:prefLabel><skos:prefLabel xml:lang="en">historic buildings</skos:prefLabel><skos:prefLabel xml:lang="nl">historische gebouwen</skos:prefLabel><skos:prefLabel xml:lang="es">edificios históricos</skos:prefLabel><skos:note xml:lang="pt">Edifícios significativos na história da arquitetura, que incorporam características arquitetônicas significativas ou que desempenharam papéis históricos significativos no desenvolvimento cultural ou social local; pode ou não ser oficialmente designado. Para edifícios abandonados, mas não considerados necessariamente históricos, use "edifícios abandonados".</skos:note><skos:note xml:lang="en">Buildings that are significant in the history of architecture, that incorporate significant architectural features, or that played significant historic roles in local cultural or social development; may or may not be officially designated. For buildings that are abandoned but not considered necessarily historic, use "abandoned buildings."</skos:note><skos:note xml:lang="es">Edificio que es significativo desde el punto de vista de la historia de la arquitectura, que incorpora características arquitectónicas importantes o que juega un papel histórico relevante en el desarrollo local cultural o social. Puede o no estar diseñado oficialmente.</skos:note><skos:note xml:lang="nl">Wordt gebruikt voor gebouwen die van belang zijn in de geschiedenis van de architectuur, die belangrijke architectonische elementen bevatten of die een belangrijke historische rol hebben gespeeld in de plaatselijke culturele of sociale ontwikkeling; kan al of niet officieel zijn aangewezen.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300004790"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/254/EA_set8_82638"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/254/EA_set8_82638"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510556"></edm:dataProvider><edm:isShownAt rdf:resource="http://ea-and.civitat.com/?id=EA-AND-82638"/><edm:isShownBy rdf:resource="https://sketchfab.com/models/cbc4cb881a0149b39f8ff94cfa2cff6b/embed?autostart=1"/><edm:object rdf:resource="https://www.eheritage.si/AN3DP/00405_IQCCTMLRDKVCFJOJOYXD.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671084"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc-nd/4.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/254/EA_set8_82638"><dc:date xml:lang="sl">1900-1910/1920</dc:date><dc:description xml:lang="en">A 3D model of a secession-style ceramic flower stand, inventory no.510: LJU; 0011577</dc:description><dc:identifier>EA-set8-82638</dc:identifier><dc:language>slv</dc:language><dc:title xml:lang="en">Stand (for flowers)</dc:title><dcterms:spatial xml:lang="sl">EA-set8-82638#place</dcterms:spatial><dcterms:temporal xml:lang="sl">EA-set8-82638#time</dcterms:temporal><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/254/EA_set8_82638"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/254/EA_set8_82638"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/provider/254/EA_set8_82638"/><edm:type>3D</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/254/EA_set8_82638"><dc:creator xml:lang="sl">Muzej in galerije mesta Ljubljane</dc:creator><dc:date>1900-1910/1920</dc:date><dc:description xml:lang="sl">3D model keramičnega stojala za rože v secesijskem slogu, inventarna št.: 510:LJU;0011577</dc:description><dc:identifier>EA-AND-82638</dc:identifier><dc:language xml:lang="en">Slovenian</dc:language><dc:subject rdf:resource="http://vocab.getty.edu/aat/300021313"></dc:subject><dc:subject rdf:resource="http://vocab.getty.edu/aat/300008063"></dc:subject><dc:subject rdf:resource="http://vocab.getty.edu/aat/300265448"></dc:subject><dc:title xml:lang="sl">Stojalo (za rože)</dc:title><dc:type xml:lang="en">3D</dc:type><dcterms:isPartOf xml:lang="en">Europeana Archaeology</dcterms:isPartOf><dcterms:spatial>EA-set8-82638#place</dcterms:spatial><dcterms:temporal>EA-set8-82638#time</dcterms:temporal><edm:europeanaProxy>false</edm:europeanaProxy><ore:prox