<?xml version="1.0" encoding="UTF-8" standalone="yes"?><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:edm="http://www.europeana.eu/schemas/edm/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:wgs84_pos="http://www.w3.org/2003/01/geo/wgs84_pos#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:rdaGr2="http://rdvocab.info/ElementsGr2/" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:ebucore="http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#" xmlns:doap="http://usefulinc.com/ns/doap#" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:cc="http://creativecommons.org/ns#" xmlns:ore="http://www.openarchives.org/ore/terms/" xmlns:svcs="http://rdfs.org/sioc/services#" xmlns:oa="http://www.w3.org/ns/oa#" xmlns:dqv="http://www.w3.org/ns/dqv#"><edm:ProvidedCHO rdf:about="http://data.europeana.eu/item/254/EA_set8_82626"/><edm:WebResource rdf:about="https://sketchfab.com/models/c6b8e812ecc441ef9a573a121424118f/embed?autostart=1"><dc:creator xml:lang="sl">Muzej in galerije mesta Ljubljane</dc:creator><dc:format>gltf</dc:format><dc:rights xml:lang="sl">copyright: Muzej in galerije mesta Ljubljane</dc:rights><rdf:type rdf:resource="http://www.europeana.eu/schemas/edm/FullTextResource"/><ebucore:hasMimeType>text/html</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">102564</ebucore:fileByteSize></edm:WebResource><edm:WebResource rdf:about="http://ea-and.civitat.com/?id=EA-AND-82626"><ebucore:hasMimeType>text/html</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">9280</ebucore:fileByteSize></edm:WebResource><edm:WebResource rdf:about="https://www.eheritage.si/AN3DP/00422_YSCUWRHEEBXDRKKKXPCR.jpg"><ebucore:hasMimeType>image/jpeg</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">12111</ebucore:fileByteSize><ebucore:width rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">326</ebucore:width><ebucore:height rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">255</ebucore:height><edm:hasColorSpace>grayscale</edm:hasColorSpace><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#A9A9A9</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FAF0E6</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#B0C4DE</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#E6E6FA</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#DCDCDC</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FFF0F5</edm:componentColor><ebucore:orientation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">landscape</ebucore:orientation></edm:WebResource><edm:Place rdf:about="EA-set8-82626#place"><wgs84_pos:lat>46.046894</wgs84_pos:lat><wgs84_pos:long>14.50417</wgs84_pos:long><skos:prefLabel xml:lang="sl">Ljubljana, Slovenija</skos:prefLabel></edm:Place><edm:TimeSpan rdf:about="EA-set8-82626#time"><skos:prefLabel>Art Nouveau</skos:prefLabel><edm:begin>1890</edm:begin><edm:end>1910</edm:end><owl:sameAs rdf:resource="http://vocab.getty.edu/page/aat/300021430"/></edm:TimeSpan><skos:Concept rdf:about="http://vocab.getty.edu/aat/300021313"><skos:prefLabel xml:lang="de">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="zh-hant">青年風格</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-wadegile">ch'ing nien feng ko</skos:prefLabel><skos:prefLabel xml:lang="en">Jugendstil (German, Austrian Art Nouveau)</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-hanyu">qīng nián fēng gé</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-notone">qing nian feng ge</skos:prefLabel><skos:prefLabel xml:lang="nl">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="es">Jugendstil</skos:prefLabel><skos:note xml:lang="zh-hant">是指德國和奧地利的新藝術風格，以1896年的青年（Jugend）雜誌命名。此種風格與比利時及法國的新藝術風格不同之處，在於對裝飾的運用較為節制。青年風格是以比較拘謹的美學取代其他新藝術風格的生氣蓬勃和自然主義，師從自然，但無法直接辨識出其取材的自然形狀。</skos:note><skos:note xml:lang="en">Refers to the German and Austrian variation of Art Nouveau, named after the magazine "Jugend" that had been published in Munich since 1896. The style differs from Belgian and French Art Nouveau by a more restrained use of decoration. Jugendstil replaced the exuberance and naturalism of other Art Nouveau styles with a comparatively subdued aesthetic that was often almost unrecognizably, or not at all derived from nature.</skos:note><skos:note xml:lang="nl">Verwijst naar de Duitse en Oostenrijkse vorm van de Art Nouveau, vernoemd naar het tijdschrift Jugend in 1896. De stijl wordt gekenmerkt door een meer ingetogen gebruik van decoratie dan de Belgische en Franse Art Nouveau.</skos:note><skos:note xml:lang="es">Se refiere a la forma alemana y austríaca de Art Nouveau, nombrado después de la revista Jugend en 1896. El estilo se caracteriza por un uso más moderado de la decoración que el Art Nouveau belga y francés.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300021430"/><skos:broader rdf:resource="http://vocab.getty.edu/aat/300020656"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300265440"><skos:altLabel xml:lang="la">octavus</skos:altLabel><skos:altLabel xml:lang="en">8vo</skos:altLabel><skos:altLabel xml:lang="it">volume in ottavo</skos:altLabel><skos:altLabel xml:lang="fr">in octavo</skos:altLabel><skos:altLabel xml:lang="es">in-octavo</skos:altLabel><skos:prefLabel xml:lang="zh-hant">八開本</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-wadegile">pa k'ai pen</skos:prefLabel><skos:prefLabel xml:lang="en">octavo</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-hanyu">bā kāi běn</skos:prefLabel><skos:prefLabel xml:lang="it">in ottavo</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-notone">ba kai ben</skos:prefLabel><skos:prefLabel xml:lang="nl">octavo</skos:prefLabel><skos:prefLabel xml:lang="es">octavo</skos:prefLabel><skos:note xml:lang="zh-hant">將一張紙直角對摺三次之後產生的書籍規格，是原來紙張尺寸的8分之一開，同時造成16個頁面。未切邊的頁面尺寸大約為12 ½ x 9 ½ 英吋。此詞彙常見於紙張尺寸相關之用語。</skos:note><skos:note xml:lang="en">Book format that results from folding a sheet of paper with three right angle folds, producing a leaf one-eighth the size of the original sheet, and creating 16 pages. The resulting untrimmed page size would be 12 1/2 by 9 1/2 inches. The term itself is frequently coupled with a paper size.</skos:note><skos:note xml:lang="es">Formato de libro que resulta de doblar una hoja de papel con tres ángulos rectos, produciendo una hoja del tamaño de un octavo de la dimensión original y creando 16 páginas. El resultado de las páginas sin cortar darían 12 1/2 por 9 1/12 pulgadas. Este término se asocia frecuentemente con tamaño de papel.</skos:note><skos:note xml:lang="nl">Boekformaat dat resulteert nadat een vel papier drie keer is gevouwen. Er ontstaat dan een blad dat een achtste van het formaat van het oorspronkelijke vel heeft, met 16 pagina's. De resulterende paginagrootte (zonder bijsnijden) wordt dan 318 x 241 mm. De term zelf wordt vaak gebruikt in verband met een papierformaat.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300266038"/><skos:broader rdf:resource="http://vocab.getty.edu/aat/300266035"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300008063"><skos:altLabel xml:lang="pt">edifício histórico</skos:altLabel><skos:altLabel xml:lang="en">historic building</skos:altLabel><skos:altLabel xml:lang="en">buildings, historic</skos:altLabel><skos:altLabel xml:lang="en">heritage buildings</skos:altLabel><skos:altLabel xml:lang="en">heritage building</skos:altLabel><skos:altLabel xml:lang="nl">historisch gebouw</skos:altLabel><skos:altLabel xml:lang="es">edificio histórico</skos:altLabel><skos:prefLabel xml:lang="pt">edifícios históricos</skos:prefLabel><skos:prefLabel xml:lang="en">historic buildings</skos:prefLabel><skos:prefLabel xml:lang="nl">historische gebouwen</skos:prefLabel><skos:prefLabel xml:lang="es">edificios históricos</skos:prefLabel><skos:note xml:lang="pt">Edifícios significativos na história da arquitetura, que incorporam características arquitetônicas significativas ou que desempenharam papéis históricos significativos no desenvolvimento cultural ou social local; pode ou não ser oficialmente designado. Para edifícios abandonados, mas não considerados necessariamente históricos, use "edifícios abandonados".</skos:note><skos:note xml:lang="en">Buildings that are significant in the history of architecture, that incorporate significant architectural features, or that played significant historic roles in local cultural or social development; may or may not be officially designated. For buildings that are abandoned but not considered necessarily historic, use "abandoned buildings."</skos:note><skos:note xml:lang="es">Edificio que es significativo desde el punto de vista de la historia de la arquitectura, que incorpora características arquitectónicas importantes o que juega un papel histórico relevante en el desarrollo local cultural o social. Puede o no estar diseñado oficialmente.</skos:note><skos:note xml:lang="nl">Wordt gebruikt voor gebouwen die van belang zijn in de geschiedenis van de architectuur, die belangrijke architectonische elementen bevatten of die een belangrijke historische rol hebben gespeeld in de plaatselijke culturele of sociale ontwikkeling; kan al of niet officieel zijn aangewezen.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300004790"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/254/EA_set8_82626"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/254/EA_set8_82626"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510556"></edm:dataProvider><edm:isShownAt rdf:resource="http://ea-and.civitat.com/?id=EA-AND-82626"/><edm:isShownBy rdf:resource="https://sketchfab.com/models/c6b8e812ecc441ef9a573a121424118f/embed?autostart=1"/><edm:object rdf:resource="https://www.eheritage.si/AN3DP/00422_YSCUWRHEEBXDRKKKXPCR.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671084"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc-nd/4.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/254/EA_set8_82626"><dc:creator xml:lang="sl">Muzej in galerije mesta Ljubljane</dc:creator><dc:date>prva polovica 20. stoletja</dc:date><dc:description xml:lang="sl">3D model keramične vaze v secesijskem slogu, inventarna št.: 510:LJU;0028558</dc:description><dc:identifier>EA-AND-82626</dc:identifier><dc:language xml:lang="en">Slovenian</dc:language><dc:subject rdf:resource="http://vocab.getty.edu/aat/300021313"></dc:subject><dc:subject rdf:resource="http://vocab.getty.edu/aat/300008063"></dc:subject><dc:subject rdf:resource="http://vocab.getty.edu/aat/300265440"></dc:subject><dc:title xml:lang="sl">Vaza</dc:title><dc:type xml:lang="en">3D</dc:type><dcterms:isPartOf xml:lang="en">Europeana Archaeology</dcterms:isPartOf><dcterms:spatial>EA-set8-82626#place</dcterms:spatial><dcterms:temporal>EA-set8-82626#time</dcterms:temporal><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/254/EA_set8_82626"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/254/EA_set8_82626"/><edm:type>3D</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/254/EA_set8_82626"><dc:date xml:lang="sl">prva polovica 20. stoletja</dc:date><dc:identifier>EA-set8-82626</dc:identifier><dc:language>slv</dc:language><dcterms:spatial xml:lang="en">EA-set8-82626#place</dcterms:spatial><