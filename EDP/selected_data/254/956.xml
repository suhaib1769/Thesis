MLSchema#hexBinary">#FFF0F5</edm:componentColor><ebucore:orientation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">landscape</ebucore:orientation></edm:WebResource><edm:WebResource rdf:about="http://ea-and.civitat.com/?id=EA-AND-81965"><ebucore:hasMimeType>text/html</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">9280</ebucore:fileByteSize></edm:WebResource><edm:WebResource rdf:about="https://sketchfab.com/models/cd663e0800554a5baa52686e02db1d6b/embed?autostart=1"><dc:creator xml:lang="sl">Narodna galerija Slovenije</dc:creator><dc:format>gltf</dc:format><dc:rights xml:lang="sl">copyright: Narodna galerija Slovenije</dc:rights><rdf:type rdf:resource="http://www.europeana.eu/schemas/edm/FullTextResource"/><ebucore:hasMimeType>text/html</ebucore:hasMimeType><ebucore:fileByteSize rdf:datatype="http://www.w3.org/2001/XMLSchema#long">102185</ebucore:fileByteSize></edm:WebResource><edm:Place rdf:about="EA-set8-81965#place"><wgs84_pos:lat>46.05401</wgs84_pos:lat><wgs84_pos:long>14.500277</wgs84_pos:long><skos:prefLabel xml:lang="sl">Ljubljana, Slovenija</skos:prefLabel></edm:Place><edm:TimeSpan rdf:about="EA-set8-81965#time"><skos:prefLabel>Art Nouveau</skos:prefLabel><edm:begin>1890</edm:begin><edm:end>1910</edm:end><owl:sameAs rdf:resource="http://vocab.getty.edu/page/aat/300021430"/></edm:TimeSpan><skos:Concept rdf:about="http://vocab.getty.edu/aat/300021313"><skos:prefLabel xml:lang="de">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="zh-hant">青年風格</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-wadegile">ch'ing nien feng ko</skos:prefLabel><skos:prefLabel xml:lang="en">Jugendstil (German, Austrian Art Nouveau)</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-hanyu">qīng nián fēng gé</skos:prefLabel><skos:prefLabel xml:lang="zh-latn-pinyin-x-notone">qing nian feng ge</skos:prefLabel><skos:prefLabel xml:lang="nl">Jugendstil</skos:prefLabel><skos:prefLabel xml:lang="es">Jugendstil</skos:prefLabel><skos:note xml:lang="zh-hant">是指德國和奧地利的新藝術風格，以1896年的青年（Jugend）雜誌命名。此種風格與比利時及法國的新藝術風格不同之處，在於對裝飾的運用較為節制。青年風格是以比較拘謹的美學取代其他新藝術風格的生氣蓬勃和自然主義，師從自然，但無法直接辨識出其取材的自然形狀。</skos:note><skos:note xml:lang="en">Refers to the German and Austrian variation of Art Nouveau, named after the magazine "Jugend" that had been published in Munich since 1896. The style differs from Belgian and French Art Nouveau by a more restrained use of decoration. Jugendstil replaced the exuberance and naturalism of other Art Nouveau styles with a comparatively subdued aesthetic that was often almost unrecognizably, or not at all derived from nature.</skos:note><skos:note xml:lang="nl">Verwijst naar de Duitse en Oostenrijkse vorm van de Art Nouveau, vernoemd naar het tijdschrift Jugend in 1896. De stijl wordt gekenmerkt door een meer ingetogen gebruik van decoratie dan de Belgische en Franse Art Nouveau.</skos:note><skos:note xml:lang="es">Se refiere a la forma alemana y austríaca de Art Nouveau, nombrado después de la revista Jugend en 1896. El estilo se caracteriza por un uso más moderado de la decoración que el Art Nouveau belga y francés.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300021430"/><skos:broader rdf:resource="http://vocab.getty.edu/aat/300020656"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300265452"><skos:altLabel xml:lang="en">folio, elephant</skos:altLabel><skos:prefLabel xml:lang="en">elephant folio</skos:prefLabel><skos:note xml:lang="en">Book size having height dimension of approximately 23 inches (58 cm).</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300266038"/><skos:broader rdf:resource="http://vocab.getty.edu/aat/300266035"/><skos:inScheme rdf:resource="http://vocab.getty.edu/aat/"/><skos:related rdf:resource="http://vocab.getty.edu/aat/300265454"/></skos:Concept><skos:Concept rdf:about="http://vocab.getty.edu/aat/300008063"><skos:altLabel xml:lang="pt">edifício histórico</skos:altLabel><skos:altLabel xml:lang="en">historic building</skos:altLabel><skos:altLabel xml:lang="en">buildings, historic</skos:altLabel><skos:altLabel xml:lang="en">heritage buildings</skos:altLabel><skos:altLabel xml:lang="en">heritage building</skos:altLabel><skos:altLabel xml:lang="nl">historisch gebouw</skos:altLabel><skos:altLabel xml:lang="es">edificio histórico</skos:altLabel><skos:prefLabel xml:lang="pt">edifícios históricos</skos:prefLabel><skos:prefLabel xml:lang="en">historic buildings</skos:prefLabel><skos:prefLabel xml:lang="nl">historische gebouwen</skos:prefLabel><skos:prefLabel xml:lang="es">edificios históricos</skos:prefLabel><skos:note xml:lang="pt">Edifícios significativos na história da arquitetura, que incorporam características arquitetônicas significativas ou que desempenharam papéis históricos significativos no desenvolvimento cultural ou social local; pode ou não ser oficialmente designado. Para edifícios abandonados, mas não considerados necessariamente históricos, use "edifícios abandonados".</skos:note><skos:note xml:lang="en">Buildings that are significant in the history of architecture, that incorporate significant architectural features, or that played significant historic roles in local cultural or social development; may or may not be officially designated. For buildings that are abandoned but not considered necessarily historic, use "abandoned buildings."</skos:note><skos:note xml:lang="es">Edificio que es significativo desde el punto de vista de la historia de la arquitectura, que incorpora características arquitectónicas importantes o que juega un papel histórico relevante en el desarrollo local cultural o social. Puede o no estar diseñado oficialmente.</skos:note><skos:note xml:lang="nl">Wordt gebruikt voor gebouwen die van belang zijn in de geschiedenis van de architectuur, die belangrijke architectonische elementen bevatten of die een belangrijke historische rol hebben gespeeld in de plaatselijke culturele of sociale ontwikkeling; kan al of niet officieel zijn aangewezen.</skos:note><skos:broader rdf:resource="http://vocab.getty.edu/aat/300004790"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/254/EA_set8_81965"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/254/EA_set8_81965"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510612"></edm:dataProvider><edm:isShownAt rdf:resource="http://ea-and.civitat.com/?id=EA-AND-81965"/><edm:isShownBy rdf:resource="https://sketchfab.com/models/cd663e0800554a5baa52686e02db1d6b/embed?autostart=1"/><edm:object rdf:resource="https://www.eheritage.si/AN3DP/00428_QVULUBPJGEAVCGJQJJBK.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671084"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc-nd/4.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/254/EA_set8_81965"><dc:creator xml:lang="sl">Ivan Povirek</dc:creator><dc:creator xml:lang="sl">Narodna galerija Slovenije</dc:creator><dc:date>začetek 20. stoletja</dc:date><dc:description xml:lang="sl">3D model bronastega kipa Dečka borilca, inventarna št.: NG 389</dc:description><dc:identifier>EA-AND-81965</dc:identifier><dc:language xml:lang="en">Slovenian</dc:language><dc:subject rdf:resource="http://vocab.getty.edu/aat/300021313"></dc:subject><dc:subject rdf:resource="http://vocab.getty.edu/aat/300008063"></dc:subject><dc:subject rdf:resource="http://vocab.getty.edu/aat/300265452"></dc:subject><dc:title xml:lang="sl">Dečka borilca</dc:title><dc:type xml:lang="en">3D</dc:type><dcterms:isPartOf xml:lang="en">Europeana Archaeology</dcterms:isPartOf><dcterms:spatial>EA-set8-81965#place</dcterms:spatial><dcterms:temporal>EA-set8-81965#time</dcterms:temporal><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/254/EA_set8_81965"/><ore:proxyIn rdf:resource