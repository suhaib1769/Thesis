df:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9172__technical_number_"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502122"></edm:dataProvider><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193650360.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193650399.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193650464.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193650527.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/100h_29193650360.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/100h_29193650399.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/100h_29193650464.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/100h_29193650527.jpg"/><edm:isShownAt rdf:resource="http://www.museum-digital.de/berlin/index.php?t=objekt&amp;oges=9172"/><edm:isShownBy rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193650294.jpg"/><edm:object rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193650294.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671142"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by/4.0/"/><edm:intermediateProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510547"></edm:intermediateProvider></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9172__technical_number_"><dc:creator xml:lang="de">Reichsbahn-Ausbesserungswerk Braunschweig</dc:creator><dc:description xml:lang="de">Zur Beförderung schwerer Züge plante die Deutsche Reichsbahn den vermehrten Einsatz von größeren Lokomotiven. Zu diesem Zweck sollten Strecken, für Maschinen von 20 t Achslast, ausgebaut werden. Das Programm zur Verstärkung der Brücken dauerte aus finanziellen Gründen länger als erwartet. Die Deutsche Reichsbahn sah sich gezwungen, von 1930 bis 1937, zum Ersatz älterer Schnellzugmaschinen auch leichte Schnellzugloks (Reihe 03) zu beschaffen. Bei diesen Zügen lagen die Achslasten bei unter 20 t (17 t bis 18 t). Das Modell wurde 1934/36 von Lehrlingen des Ausbesserungswerks Braunschweig gebaut.&lt;br />
