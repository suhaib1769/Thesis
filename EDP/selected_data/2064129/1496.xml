h rdf:resource="http://purl.org/bncf/tid/16721"/><skos:exactMatch rdf:resource="https://www.freebase.com/m/0d1pc"/><skos:exactMatch rdf:resource="https://g.co/kg/m/0d1pc"/><skos:exactMatch rdf:resource="http://datos.bne.es/resource/XX538551"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300025848"/><skos:exactMatch rdf:resource="http://iconclass.org/41D121"/><skos:exactMatch rdf:resource="http://www.yso.fi/onto/yso/p27565"/><skos:exactMatch rdf:resource="http://babelnet.org/rdf/s00033735n"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Model_(person)"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9119__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9119__technical_number_"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502122"></edm:dataProvider><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193632525.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193632623.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/100h_29193632525.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/100h_29193632623.jpg"/><edm:isShownAt rdf:resource="http://www.museum-digital.de/berlin/index.php?t=objekt&amp;oges=9119"/><edm:isShownBy rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193632378.jpg"/><edm:object rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193632378.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671142"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by/4.0/"/><edm:intermediateProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510547"></edm:intermediateProvider></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9119__technical_number_"><dc:description xml:lang="en">The Moselle route was only created in 1879, after the Franco-German war (1870 to 1871). At the lower reaches of the Mosel, the railway follows the river bank, while at the upper reaches to Trier it cuts off all river loops. It served a quick connection between Berlin and Metz, as well as the departure of the Lorraine iron ores. The largest technical power was the installation of the 4203-meter-long “Kaiser-Wilhelm-Tunnel.” Due to the smoke development of the steam locomotives, he received a ventilation system of the “Saccardo type.” The steam engines are missing today on the model.&lt;br/>
&lt;br/>
Traffic and construction museum. Official guide through the collections/Transport and Construction Museum Berlin. Berlin: Elsner, 1943. P. 30; Annalen, 13th c., 15.08.1906, No. 700, p. 70 f (Fig. and Table 4); Kurier EK railway 1979, H. 5, p. 5ff (Fig. 6); Kurier EK railway 1979, H. 8, p. 17f; Kurier EK railway 1988, H. 12, p. 21ff; Kurier EK railway 1989, H. 1, p. 26ff (Fig.);, Railway Magazine. Model railway, magazine 25. Jg., September 1987, H. 9, (Fig. Model photo) (Deutsches Technikmuseum)</dc:description><dc:rights xml:lang="de">Deutsches Technikmuseum</dc:rights><dc:subject rdf:resource="http://data.europeana.eu/concept/1954"></dc:subject><dc:subject xml:lang="en">interlocking</dc:subject><dc:subject xml:lang="en">Rail traffic</dc:subject><dc:subject xml:lang="en">Railway station</dc:subject><dc:title xml:lang="en">Portal of the Kaiser-Wilhelm tunnel near Cochem, Model 1: 20</dc:title><dc:type rdf:resource="http://data.europeana.eu/concept/1954"></dc:type><dcterms:created rdf:resource="#1879"></dcterms:created><dcterms:created xml:lang="zxx">1879</dcterms:created><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:spatial xml:lang="de">Konz</dcterms:spatial><dcterms:spatial xml:lang="en">Konz</dcterms:spatial><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1879</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9119__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9119__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9119__technical_number_"><dc:creator xml:lang="de">Eisenbahn-Lehrlingswerkstatt Konz (Mosel)</dc:creator><dc:description xml:lang="de">Die Moselstrecke ist erst 1879, nach dem deutsch-französischen Krieg (1870 bis 1871), angelegt worden. Am Unterlauf der Mosel folgt die Bahn dem Flußufer, während sie am Oberlauf bis Trier alle Flußschleifen abschneidet. Sie diente einer raschen Verbindung zwischen Berlin und Metz, sowie der Abfuhr der lothringischen Eisenerze. Größte technische Leistung war die Anlage des 4203 Meter langen »Kaiser-Wilhelm-Tunnels«. Wegen der  Rauchentwicklung der Dampfloks erhielt er eine Lüftungsanlage der »Bauart Saccardo«. Die antreibenden Dampfmaschinen fehlen heute auf dem Modell.&lt;br />
&lt;br />
