eativecommons.org/licenses/by/4.0/"/><edm:intermediateProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510547"></edm:intermediateProvider></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9065__technical_number_"><dc:creator xml:lang="en">Siemens-Schuckertwerke (SSW)</dc:creator><dc:format xml:lang="en">metal, wood</dc:format><dc:rights xml:lang="de">Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="en">Local transport</dc:subject><dc:subject xml:lang="en">Floating railway</dc:subject><dc:title xml:lang="en">Floating railway vehicle No. 9 of Wuppertaler Schwebebahn</dc:title><dc:type xml:lang="en">Local transport</dc:type><dc:type xml:lang="en">Floating railway</dc:type><dc:type xml:lang="en">Man-made object</dc:type><dc:type xml:lang="en">Local transport</dc:type><dcterms:created rdf:resource="#1900"></dcterms:created><dcterms:created rdf:resource="#1900"></dcterms:created><dcterms:created xml:lang="zxx">1900</dcterms:created><dcterms:extent xml:lang="de">Objektmaß LxBxH: 11900 x 2100 x 2600 mm; Masse: 1300 kg</dcterms:extent><dcterms:extent xml:lang="en">Object dimension LxBxH: 11900 x 2100 x 2600 mm; mass: 1300 kg</dcterms:extent><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1900</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9065__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9065__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9065__technical_number_"><dc:creator xml:lang="de">Siemens-Schuckertwerke (SSW)</dc:creator><dc:creator xml:lang="de">Siemens-Schuckertwerke (SSW)</dc:creator><dc:description xml:lang="de">Carl Eugen Langen entwickelte ab 1891 ein Einschienen-Hängebahnsystem. Von 1901 bis 1903 entstand nach diesem Vorbild die Schwebebahn Vohwinkel-Elberfeld-Oberbarmen. Zwischen 1902 und 1913 bestanden Pläne auch für Berlin: Die Strecke Gesundbrunnen-Alexanderplatz-Rixdorf sollte mit diesem System ausgerüstet werden. Das Projekt wurde aber schließlich als konventionelle Schnellbahn ausgeführt (heutige U-Bahn-Linie 8).&lt;br />
Das Fahrzeug gehört zur Baureihe 1900, Typ B 00 und ist ein Vorderwagen. Die Ausstattung stammt aus den 1970er Jahren, bis dahin waren Wagen dieser Baureihe in Betrieb. Ürsprünglich war es ein Wagen der 2. und 3. Klasse. &lt;br />
Gesamtplätze: 65 (Sitzplätze II Klasse: 10, III Kl.:15, Stehplätze  II Kl.: 14, Stehplätze III Kl.: 26)&lt;br />
&lt;br />
Arbeitsheft 19, hrsg. v. Landeskonservator Rheinland, Hans-Fried Schierk, Norbert Schmidt, Die Schwebebahn in Wuppertal, 1976;&lt;br />
Zur Geschichte der Hochbahn, in Elektrotechnische Zeitschrift, 1901, Heft 26;  (Deutsches Technikmuseum)</dc:description><dc:format xml:lang="de">Metall, Holz</dc:format><dc:identifier>1/1980/0428 0  (inventory number)</dc:identifier><dc:identifier>9065 (technical number)</dc:identifier><dc:rights>Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="de">Kommunalverkehr</dc:subject><dc:subject xml:lang="de">Schwebebahn</dc:subject><dc:title xml:lang="de">Schwebebahnwagen Nr. 9 der Wuppertaler Schwebebahn</dc:title><dc:type xml:lang="de">Kommunalverkehr</dc:type><dc:type xml:lang="de">Schwebebahn</dc:type><dc:type xml:lang="de">Man-made object</dc:type><dc:type xml:lang="de">Kommunalverkehr</dc:type><dcterms:created>1900</dcterms:created><dcterms:created>1900</dcterms:created><dcterms:extent>Objektmaß LxBxH: 11900 x 2100 x 2600 mm; Masse: 1300 kg</dcterms:extent><dcterms:provenance>Deutsches Technikmuseum, Berlin</dcterms:provenance><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9065__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9065__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9065__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9065__technical_number_"/><edm:datasetName>2064129_ Stiftung Deutsches Technikmuseum Berlin</edm:datasetName><edm:country>Germany</edm:country><edm:preview rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29192526966.jpg"/><edm:landingPage rdf:resource="https://www.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9065__technical_number_"/><edm:language>de</edm:language><edm:completeness>10</edm:completene