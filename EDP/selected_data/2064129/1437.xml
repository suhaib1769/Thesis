ttp://data.europeana.eu/organization/1482250000004510547"></edm:intermediateProvider></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9060__technical_number_"><dc:creator xml:lang="en">Sandt J. Machine-Factory</dc:creator><dc:description xml:lang="en">The punch is used to punch the individual parts of a shoe. For this purpose, special statues are used, which exist in different shapes and shoe sizes. It depends on the use of the shoe, whether leather or thick film wool, for example for slippers, is used.  (Deutsches Technikmuseum)</dc:description><dc:rights xml:lang="de">Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="en">punching tool</dc:subject><dc:title xml:lang="en">Stanze Exenter, shoemaker’s pole</dc:title><dcterms:created xml:lang="de">1913-1917</dcterms:created><dcterms:created rdf:resource="#1913%2F1917"></dcterms:created><dcterms:created xml:lang="en">1913-1917</dcterms:created><dcterms:extent xml:lang="de">Objektmaß LxBxH: 1100 x 800 x 1700 mm; Masse: 525 kg</dcterms:extent><dcterms:extent xml:lang="en">Object dimension LxBxH: 1100 x 800 x 1700 mm; mass: 525 kg</dcterms:extent><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:spatial xml:lang="de">Pirmasens</dcterms:spatial><dcterms:spatial xml:lang="en">Pirmasens</dcterms:spatial><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9060__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9060__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9060__technical_number_"><dc:creator xml:lang="de">Sandt J. Maschinenfabrik</dc:creator><dc:description xml:lang="de">Mit der Stanze werden die einzelnen Teile aus denen ein Schuh besteht ausgestanzt. Hierfür werden spezielle Stanzeisen verwendet, die es in unterschiedlichen Formen und Schuhgrößen gibt. Es ist vom Verwendungszweck des Schuhs abhängig, ob Leder oder dicke Filzwolle, zum Beispiel für Pantoffeln, verwendet wird.  (Deutsches Technikmuseum)</dc:description><dc:identifier>1/1988/1625 0  (inventory number)</dc:identifier><dc:identifier>9060 (technical number)</dc:identifier><dc:rights>Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="de">Schuhe</dc:subject><dc:subject xml:lang="de">Stanzen (Verfahren)</dc:subject><dc:subject xml:lang="de">Stanzwerkzeug</dc:subject><dc:title xml:lang="de">Stanze Exenter, Schuhmacherstanze</dc:title><dc:type xml:lang="de">Schuhe</dc:type><dc:type xml:lang="de">Stanzen (Verfahren)</dc:type><dc:type xml:lang="de">Stanzwerkzeug</dc:type><dc:type xml:lang="de">Man-made object</dc:type><dc:type xml:lang="de">Handwerk und Produktion</dc:type><dc:type xml:lang="en">Shoes</dc:type><dc:type xml:lang="en">Punching (Metal-work)</dc:type><dcterms:created>1913-1917</dcterms:created><dcterms:extent>Objektmaß LxBxH: 1100 x 800 x 1700 mm; Masse: 525 kg</dcterms:extent><dcterms:provenance>Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:spatial>Pirmasens</dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9060__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9060__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9060__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9060__technical_number_"/><edm:d