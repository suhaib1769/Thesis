efLabel xml:lang="cs">Kov</skos:prefLabel><skos:prefLabel xml:lang="pl">Metal</skos:prefLabel><skos:prefLabel xml:lang="ro">Metal</skos:prefLabel><skos:prefLabel xml:lang="da">Metal</skos:prefLabel><skos:prefLabel xml:lang="nl">Metaal</skos:prefLabel><skos:note xml:lang="de">Gruppe chemischer Elemente</skos:note><skos:note xml:lang="fi">Alkuaineryhmä</skos:note><skos:note xml:lang="sv">Grundämne eller legering med metalliska egenskaper</skos:note><skos:note xml:lang="ru">Элемент, материал, проводник тока и электричества</skos:note><skos:note xml:lang="pt">Material que conduz facilmente eletricidade e calor</skos:note><skos:note xml:lang="el">Στοιχείο, ένωση ή κράμα που είναι καλός αγωγός ηλεκτρικής ενέργειας και θερμότητας.</skos:note><skos:note xml:lang="en">Element, compound, or alloy that is a good conductor of both electricity and heat; ancient Chinese element</skos:note><skos:note xml:lang="it">Elemento, composto o lega che è un buon conduttore di luce e calore</skos:note><skos:note xml:lang="fr">Classe de matériaux le plus souvent durs, opaques, brillants, bons conducteurs de la chaleur et de l’électricité, dont les atomes sont unis par des liaisons métalliques</skos:note><skos:note xml:lang="es">Elemento, aleación o compuesto conductor de electricidad y calor</skos:note><skos:note xml:lang="cs">Druh materiálu či prvku, který dobře vede proud a teplo</skos:note><skos:note xml:lang="da">Element eller legering med metalliske egenskaber</skos:note><skos:note xml:lang="nl">Ieder element dat gekenmerkt wordt door glans en het vermogen om warmte en elektriciteit te geleiden</skos:note><skos:note xml:lang="ca">Element, compost o aliatge que és bon conductor de l'electricitat i de la calor</skos:note><skos:broader rdf:resource="http://data.europeana.eu/concept/2069"/><skos:broader rdf:resource="http://data.europeana.eu/concept/1980"/><skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q11426"/><skos:exactMatch rdf:resource="http://id.ndl.go.jp/auth/ndlna/00565895"/><skos:exactMatch rdf:resource="http://purl.org/bncf/tid/346"/><skos:exactMatch rdf:resource="https://www.freebase.com/m/04t7l"/><skos:exactMatch rdf:resource="https://g.co/kg/m/04t7l"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300010900"/><skos:exactMatch rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10545"/><skos:exactMatch rdf:resource="http://zbw.eu/stw/descriptor/14266-6"/><skos:exactMatch rdf:resource="http://vocabularies.unesco.org/thesaurus/concept641"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Metal"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9078__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9078__technical_number_"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502122"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.museum-digital.de/berlin/index.php?t=objekt&amp;oges=9078"/><edm:isShownBy rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29192938316.jpg"/><edm:object rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29192938316.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671142"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by/4.0/"/><edm:intermediateProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510547"></edm:intermediateProvider></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9078__technical_number_"><dc:description xml:lang="en">The first major step towards global networking was a thin cable of hardly two centimeters in diameter. In August 1858, the first words between Europe and North America were telegraphed about this - at that time a world sensation: messages that reached their addressee only after almost two weeks ago by ship, now in a matter of seconds they crossed the ocean.&lt;br/>
Today, undersea cables form the backbone of the networked world - only that they are made of glass instead of copper and instead of a sign they can transmit over a trillion units of information per second.&lt;br/>
&lt;br/>
  (Deutsches Technikmuseum)</dc:description><dc:format rdf:resource="http://data.europeana.eu/concept/1766"></dc:format><dc:format xml:lang="en">metal</dc:format><dc:rights xml:lang="de">Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="en">Telecommunications</dc:subject><dc:subject xml:lang="en">Transmission technology</dc:subject><dc:subject xml:lang="en">Sea cable</dc:subject><dc:subject xml:lang="en">Telegraphy</dc:subject><dc:title xml:lang="en">Cable section of the first transatlantic telegraphy cable Atlantic Telegraph Cable</dc:title><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9078__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9078__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9078__technical_number_"><dc:description xml:lang="de">Der erste große Schritt zur weltweiten Vernetzung war ein dünnes Kabel von kaum zwei Zentimetern Durchmesser. Im August 1858 wurden darüber die ersten Worte zwischen Europa und Nordamerika telegrafiert – damals eine Weltsensation: Nachrichten, die vorher per Schiff erst nach knapp zwei Wochen ihren Adressaten erreichten, unterquerten nun in Sekundenschnelle den Ozean.&lt;br />
Heute bilden unterseeische Kabel wieder das Rückgrat der vernetzten Welt – bloß, dass sie aus Glas bestehen statt aus Kupfer und anstelle von einem Zeichen über eine Billionen Informationseinheiten pro Sekunde übertragen können.&lt;br />
&lt;br />
