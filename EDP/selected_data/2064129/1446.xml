uropeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9071__technical_number_"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502122"></edm:dataProvider><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29192529518.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/100h_29192529518.jpg"/><edm:isShownAt rdf:resource="http://www.museum-digital.de/berlin/index.php?t=objekt&amp;oges=9071"/><edm:isShownBy rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29192529255.jpg"/><edm:object rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29192529255.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671142"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by/4.0/"/><edm:intermediateProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510547"></edm:intermediateProvider></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9071__technical_number_"><dc:creator xml:lang="en">Tram Railway Company Hamburg</dc:creator><dc:description xml:lang="en">This sidecar from 1908 was built for the then Society for High and Underground Railways in Berlin. Between 1902 and 1926, 254 side-cars of this type were procured. It is the oldest surviving subway car in Berlin and was in operation at BVG (-W) until 1966. It still appears today.&lt;br/>
The cart box is made of wood and is faithfully preserved. The brake system is an original, electrically controlled two-chamber compressed air brake that acts on the wheels via wooden blocks.&lt;br/>
&lt;br/>
