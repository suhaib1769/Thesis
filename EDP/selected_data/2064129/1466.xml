ion><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9089__technical_number_"><dc:creator xml:lang="en">Fritz Schulisch</dc:creator><dc:format xml:lang="en">metal, wood</dc:format><dc:rights xml:lang="de">Deutsches Technikmuseum</dc:rights><dc:subject rdf:resource="http://data.europeana.eu/concept/1954"></dc:subject><dc:subject xml:lang="en">Rail traffic</dc:subject><dc:type rdf:resource="http://data.europeana.eu/concept/1954"></dc:type><dcterms:created rdf:resource="#1838"></dcterms:created><dcterms:created xml:lang="zxx">1838</dcterms:created><dcterms:extent xml:lang="de">Objektmaß LxBxH: 1130 x 235 x 320 mm; Masse: 25,6 kg</dcterms:extent><dcterms:extent xml:lang="en">Object dimension LxBxH: 1130 x 235 x 320 mm; mass: 25.6 kg</dcterms:extent><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:spatial xml:lang="de">Berlin-Tiergarten</dcterms:spatial><dcterms:spatial rdf:resource="http://data.europeana.eu/place/455"></dcterms:spatial><dcterms:spatial rdf:resource="http://data.europeana.eu/place/80"></dcterms:spatial><dcterms:spatial xml:lang="en">Berlin Tiergarten</dcterms:spatial><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1838</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9089__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9089__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9089__technical_number_"><dc:creator xml:lang="de">Fritz Schulisch</dc:creator><dc:description xml:lang="de">Dieses gedeckte, vierachsige Güterwagenmodell gehört zu einem Modellzug, der die erste brauchbare deutsche Dampflok "Saxonia" der Leipzig-Dresdener-Eisenbahn von 1839 nachbildete. Dazu gehörten ein Tender und einige Personen- und Güterwagen. Der Zug kam 1935 in den Bestand des Verkehrs- und Baumuseums Berlin (VBM). Viele der Anhänger, auch die Güterwagen, sind wegen Kriegsschäden in den 1950er Jahren nachgebaut worden. Im Jahre 1984 kam der Zug an das Verkehrsmuseum in Dresden, nur die Güterwagen blieben im Bestand des Deutschen Technikmuseums. (S. auch Inv.-Nr. 1/1945/0038).&lt;br />
