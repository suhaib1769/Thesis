ent><dcterms:extent xml:lang="en">Object dimension TxBxH: 70 x 170 x 570 mm</dcterms:extent><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:spatial xml:lang="de">Backnang</dcterms:spatial><dcterms:spatial xml:lang="en">Backnang</dcterms:spatial><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_40294__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_40294__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_40294__technical_number_"><dc:creator xml:lang="de">ANT Nachrichtentechnik GmbH</dc:creator><dc:creator xml:lang="de">Technikforum Backnang</dc:creator><dc:description xml:lang="de">Im Endverzweiger werden die vom Teilnehmer kommenden LWL-Kabel (Lichtwellenleiter/Glasfasern) mit dem zur Vermittlungsstelle führenden Kabel verbunden. &lt;br />
&lt;br />
Die in einem LWL-Kabel von der Vermittlungsstelle ankommenden LWL-Fasern werden im Endverzweiger auf einzelne, zum Teilnehmer führenden LWL-Fasern verteilt. Beide Glasfaserenden werden mittels eines Spleißes verbunden (Schmelzverbindung). &lt;br />
siehe hierzu   Objekt  LWL-Spleißgerät   InvNr. 1/2013/4744 000 oder   Objekt  LWL-Spleißgerät   InvNr. 1/2015/0161 000&lt;br />
Diese Endverzweiger wurden sowohl im Innen- als auch im Außenbereich eingesetzt.&lt;br />
Das vorliegende Objekt ist ein Anschauungsmodell mit Schauglas. Es wurde im Innenbereich eingesetzt. &lt;br />
&lt;br />
Typische Eigenschaften:&lt;br />
&lt;br />
-	zugfeste Kabeleinführung,&lt;br />
-	definierte Unterbringung der Glasfaserverbindung &lt;br />
-	mechanisch stabile und dicht verschließbare Umhüllung der ganzen Einheit zur Minimierung von Umwelteinflüssen  (Deutsches Technikmuseum)</dc:description><dc:identifier>1/2015/0162 (inventory number)</dc:identifier><dc:identifier>40294 (technical number)</dc:identifier><dc:rights>Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="de">Glasfaserkabel</dc:subject><dc:title xml:lang="de">Endverzweiger für LWL- Kabelanlagen</dc:title><dc:type xml:lang="de">Glasfaserkabel</dc:type><dc:type xml:lang="de">Gerät</dc:type><dc:type xml:lang="de">Kommunikation und Medien</dc:type><dc:type xml:lang="en">fibre optic cable</dc:type><dcterms:created>1983-1990</dcterms:created><dcterms:extent>Objektmaß TxBxH: 70 x 170 x 570 mm</dcterms:extent><dcterms:provenance>Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:spatial>Backnang</dcterms:spatial><dcterms:spatial>Backnang</dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_40294__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_40294__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_40294__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_40294__technical_number_"/><edm:datasetName>2064129_ Stiftung Deutsches Technikmuseum Berlin</edm:datasetName><edm:country>Germany</edm:country><edm:preview rdf:resource="http://www.museum-digital.de/data/berlin/images/201706/02105920035.jpg"/><edm:landingPage rdf:resource="https://www.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_40294__technical_number_"/><edm:language>de</edm:language><edm:completeness>10</edm:completeness><dcterms:created>2017-12-19T08:29:45.857Z</dcterms