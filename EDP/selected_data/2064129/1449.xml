7</ebucore:height><edm:hasColorSpace>sRGB</edm:hasColorSpace><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#000000</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#2F4F4F</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#556B2F</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#696969</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#800000</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FFFFFF</edm:componentColor><ebucore:orientation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">landscape</ebucore:orientation></edm:WebResource><edm:TimeSpan rdf:about="http://semium.org/time/AD2xxx"><skos:prefLabel xml:lang="en">Second millenium AD</skos:prefLabel><skos:prefLabel xml:lang="en">Second millenium AD, years 1001-2000</skos:prefLabel><skos:prefLabel xml:lang="fr">2e millénaire après J.-C.</skos:prefLabel><dcterms:isPartOf rdf:resource="http://semium.org/time/ChronologicalPeriod"></dcterms:isPartOf></edm:TimeSpan><edm:TimeSpan rdf:about="#1919"><skos:prefLabel xml:lang="zxx">1919</skos:prefLabel><dcterms:isPartOf rdf:resource="http://data.europeana.eu/timespan/20"></dcterms:isPartOf><edm:begin>1919-01-01</edm:begin><edm:end>1919-12-31</edm:end></edm:TimeSpan><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9074__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9074__technical_number_"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502122"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.museum-digital.de/berlin/index.php?t=objekt&amp;oges=9074"/><edm:isShownBy rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29192530086.jpg"/><edm:object rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29192530086.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671142"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by/4.0/"/><edm:intermediateProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510547"></edm:intermediateProvider></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9074__technical_number_"><dc:creator xml:lang="de">Allgemeine Berliner Omnibus AG (ABOAG)</dc:creator><dc:description xml:lang="de">Das Fahrzeug repräsentiert die Generation der ersten motorisierten Busse in Berlin, die seit 1905 immer häufiger im Straßenbild erschienen war. Es gehört zu einer Serie von zehn Omnibussen, die zwischen 1916 und 1920 gebaut wurde und war bis 1927 in Betrieb. Die Typenbezeichnung verweist auf den damaligen Generaldirektor der ABOAG, Robert Kaufmann.&lt;br />
Schon hier entfernte sich die Bauweise vom Lastwagenbau, um den besonderen Anforderungen des Busbetriebes zu entsprechen. Rahmen und Kasten des Busses sind aus Stahlblech, mit armiertem Eschenholz, gebaut. Der Omnibus bot 36 Sitz- sowie sechs Stehplätze an. Eingebaut wurde ein 4-Zylinder-Vergaser-Motor mit 33 kW (45 PS), der eine Höchstgescheindigkeit von 25 km/h erlaubte.&lt;br />
Zwischen 1976 und 1987 sind drei Nachbauten angefertigt und von der BVG mit großem Erfolg im Sonderverkehr eingesetzt worden.&lt;br />
&lt;br />
Schipporeit, Reiner; Reinhard Demps. Historische Fahrzeuge in Berlin: Busse, Strassenbahnen, U-Bahn, S-Bahn. Berlin: Museum für Verkehr und Technik, 1991.  S. 20 &lt;br />
FMVT Info Nr. 1, März 1995&lt;br />
Weitere Abb.: BVG 74-0528, BVG 65-481  (Deutsches Technikmuseum)</dc:description><dc:format xml:lang="de">Stahlblech, Holz</dc:format><dc:identifier>1/1992/0903 0  (inventory number)</dc:identifier><dc:identifier>9074 (technical number)</dc:identifier><dc:rights>Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="de">Kommunalverkehr</dc:subject><dc:subject xml:lang="de">Omnibusverkehr</dc:subject><dc:subject xml:lang="de">Omnibus</dc:subject><dc:title xml:lang="de">Decksitzomnibus Nr. 37 "RK-Wagen"</dc:title><dc:type xml:lang="de">Kommunalverkehr</dc:type><dc:type xml:lang="de">Omnibusverkehr</dc:type><dc:type xml:lang="de">Omnibus</dc:type><dc:type xml:lang="de">Man-made object</dc:type><dc:type xml:lang="de">Kommunalverkehr</dc:type><dc:type xml:lang="en">Buses</dc:type><dcterms:created>1919</dcterms:created><dcterms:extent>Masse: 4950 kg; Objektmaß LxBxH: 8 x 2,2 x 3,8 m</dcterms:extent><dcterms:provenance>Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:spatial>Berlin</dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9074__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9074__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9074__technical_number_"><dc:creator xml:lang="en">General Berlin Omnibus AG (ABOAG)</dc:creator><dc:description xml:lang="en">The vehicle represents the generation of the first motorized buses in Berlin, which had appeared more and more frequently since 1905. It belongs to a series of ten buses, which was built between 1916 and 1920 and was in operation until 1927. The type designation refers to the former general director of ABOAG, Robert Kaufmann.&lt;br/>
Even here, the construction of a truck was removed to meet the special requirements of the bus service. Frames and boxes of the bus are made of sheet steel, with armed ash wood. The omnibus offered 36 seats and six standing seats. A 4-cylinder carburetor engine with 33 kW (45 hp) was installed, which allowed a maximum sound of 25 km/h.&lt;br/>
Between 1976 and 1987 three replicas were made and were used by the BVG with great success in special traffic.&lt;br/>
&lt;br/>
Schipporeit, Reiner; Reinhard Demps. Historical vehicles in Berlin: buses, trams, subway, subway. Berlin: Museum of Transport and Technology, 1991.  P. 20 &lt;br/>
FMVT Info No. 1, March 1995 &lt;br/>
