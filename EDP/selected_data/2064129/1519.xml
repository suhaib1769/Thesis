y rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9143__technical_number_"><dc:rights xml:lang="de">Deutsches Technikmuseum</dc:rights><dc:subject rdf:resource="http://data.europeana.eu/concept/1954"></dc:subject><dc:subject xml:lang="en">Rail traffic</dc:subject><dc:subject xml:lang="en">Railway vehicles with propulsion</dc:subject><dc:type rdf:resource="http://data.europeana.eu/concept/1954"></dc:type><dcterms:created xml:lang="de">1901-1910</dcterms:created><dcterms:created rdf:resource="#1901%2F1910"></dcterms:created><dcterms:created xml:lang="en">1901-1910</dcterms:created><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:spatial xml:lang="de">Potsdam</dcterms:spatial><dcterms:spatial xml:lang="en">Potsdam</dcterms:spatial><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9143__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9143__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9143__technical_number_"><dc:creator xml:lang="de">Eisenbahn-Hauptwerkstätte Potsdam</dc:creator><dc:description xml:lang="de">Ab 1905 erhielt die Hamburger Vorortbahn Blankenese-Ohlsdorf ein Wechselstromsystem, mit einer Frequenz von 25 Hertz. Sie bildete die Keimzelle der späteren Hamburger S-Bahn und gilt als Vorläuferin deutscher, elektrischer Fernbahnen. &lt;br />
Ein Doppeltriebwagen bestand aus zwei Wagen, zusammen mit 123 Sitzplätzen. Dieses Modell zeigt die früheste Bauart, mit einem aus Holz gefertigten Kastengerippe und Einzelachsen an den Wagenübergängen. Hierbei wurden drei der vier äußeren Radsätze in den Drehgestellen angetrieben. Das Modell entstand 1908 bei der Eisenbahn-Hauptwerkstätte Potsdam.&lt;br />
