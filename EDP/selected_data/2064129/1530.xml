diateProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510547"></edm:intermediateProvider></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9156__technical_number_"><dc:creator xml:lang="en">Railway workshop inspection Witten</dc:creator><dc:rights xml:lang="de">Deutsches Technikmuseum</dc:rights><dc:subject rdf:resource="http://data.europeana.eu/concept/1954"></dc:subject><dc:subject xml:lang="en">Heavy transport</dc:subject><dc:subject xml:lang="en">Rail traffic</dc:subject><dc:subject xml:lang="en">Freight van</dc:subject><dc:title xml:lang="en">Eight-axle railway wagon, low-floor wagon “Essen 37526,” model 1: 5</dc:title><dc:type rdf:resource="http://data.europeana.eu/concept/1954"></dc:type><dcterms:created xml:lang="de">1891-1909</dcterms:created><dcterms:created rdf:resource="#1891%2F1909"></dcterms:created><dcterms:created xml:lang="en">1891-1909</dcterms:created><dcterms:extent xml:lang="de">Objektmaß LxBxH: 3860 x 580 x 658 mm</dcterms:extent><dcterms:extent xml:lang="en">Object dimension LxBxH: 3860 x 580 x 658 mm</dcterms:extent><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:spatial xml:lang="de">Witten</dcterms:spatial><dcterms:spatial rdf:resource="http://data.europeana.eu/place/181"></dcterms:spatial><dcterms:spatial rdf:resource="http://data.europeana.eu/place/80"></dcterms:spatial><dcterms:spatial xml:lang="en">Witten</dcterms:spatial><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9156__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9156__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9156__technical_number_"><dc:creator xml:lang="de">Eisenbahn-Werkstätten-Inspektion Witten</dc:creator><dc:description xml:lang="de">Wagen dieser Bauart konnten Landungen von bis zu 83 Tonnen Gewicht, insbesondere große und schwere Maschinenteile, befördern. Dabei lagerte das Ladegut auf dem Brückenrahmen. Für sehr hohe, aber weniger breite Teile war eine Tiefladeeinrichtung vorgesehen. Wie im Modell gezeigt, wurden dazu zwei Quertraversen an der Unterseite der Rahmenwangen befestigt. Diese Wagenbauart ließ sich auch mit Geschützen bestücken, allerdings war das Rohr hier nur um eine horizontale Achse schwenkbar. Das Modell entstand 1906 bei der Königlichen Eisenbahn-Werkstätten-Inspektion Witten.&lt;br />
