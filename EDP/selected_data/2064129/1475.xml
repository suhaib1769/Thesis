aurus/10577"/><skos:exactMatch rdf:resource="http://zbw.eu/stw/descriptor/14150-4"/><skos:exactMatch rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4159"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Wood"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9100__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9100__technical_number_"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502122"></edm:dataProvider><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193625902.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/100h_29193625902.jpg"/><edm:isShownAt rdf:resource="http://www.museum-digital.de/berlin/index.php?t=objekt&amp;oges=9100"/><edm:isShownBy rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193625730.jpg"/><edm:object rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193625730.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671142"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by/4.0/"/><edm:intermediateProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510547"></edm:intermediateProvider></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9100__technical_number_"><dc:description xml:lang="de">Gleis und Wagen wurden im Jahr 1889 bei einer damals ungarischen Goldgrube aufegfunden. Die Apostelgrube, bei Brad in Siebenbürgen, liegt seit 1918 in Rumänien. Fahrweg und Fahrzeug stammen aus der Zeit um 1550 und stellen eine sehr frühe Form des spurgeführten Transportmittels für Erze dar. Der Wagen ist aus grob behauenen Bohlen und Brettern mit eisernen Nägeln gebaut. Die Achsen sind ebenfalls aus Eisen. Schienen und Schwellen bestehen aus Rundhölzer. Auffällig ist die starke Ausbildung eines Spurkranzes an den Rädern durch die Abnutzung. Im Jahr 1910 brachte der Unternehmer August Haarmann die Bahn nach Berlin. Der Wagen hat eine Länge von 200 cm, ein Gewicht von 100 kg und ist ausgelegt für eine Spurweite von ca. 48 cm.&lt;br />
&lt;br />
Verkehrs- und Baumuseum. Amtlicher Führer durch die Sammlungen / Verkehrs- und Baumuseum Berlin. Berlin: Elsner, 1943. S. 33  (Deutsches Technikmuseum)</dc:description><dc:format xml:lang="de">Holz</dc:format><dc:identifier>1/1945/0152 0  (inventory number)</dc:identifier><dc:identifier>9100 (technical number)</dc:identifier><dc:rights>Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="de">Hunt</dc:subject><dc:subject xml:lang="de">Förderwagen (Bergbau)</dc:subject><dc:subject xml:lang="de">Schienenverkehr</dc:subject><dc:subject xml:lang="de">Vorläufer der Eisenbahn (bis 1840)</dc:subject><dc:subject xml:lang="de">Fahrweg</dc:subject><dc:title xml:lang="de">Grubenhund mit Holzschienen aus der Apostelgrube in Brad (Siebenbürgen)</dc:title><dc:type xml:lang="de">Hunt</dc:type><dc:type xml:lang="de">Förderwagen (Bergbau)</dc:type><dc:type xml:lang="de">Schienenverkehr</dc:type><dc:type xml:lang="de">Vorläufer der Eisenbahn (bis 1840)</dc:type><dc:type xml:lang="de">Fahrweg</dc:type><dc:type xml:lang="de">Förderwagen</dc:type><dc:type xml:lang="de">Schienenverkehr</dc:type><dc:type xml:lang="en">rail transport</dc:type><dc:type xml:lang="en">ser Artikel|erläutert den kartographischen Gebrauch; im Eisenbahnwesen siehe [[Fahrstraße</dc:type><dcterms:created>1501-1600</dcterms:created><dcterms:provenance>Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:spatial>Brad (Hunedoara)</dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9100__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9100__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9100__technical_number_"><dc:description xml:lang="en">In 1889, tracks and wagons were found at a then-Hungarian gold mine. The apostle pit, near Brad in Transylvania, has been in Romania since 1918. The road and vehicle date back to 1550 and represent a very early form of the track-guided means of transport for ores. The cart is made of coarse planks and boards with iron nails. The axes are also made of iron. Rails and sleepers are made of roundwood. The strong formation of a track wreath on the wheels due to wear is striking. In 1910, entrepreneur August Haarmann took the train to Berlin. The car has a length of 200 cm, a weight of 100 kg and is designed for a track width of about 48 cm.&lt;br/>
&lt;br/>
