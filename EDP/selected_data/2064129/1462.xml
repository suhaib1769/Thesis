ct><dc:subject xml:lang="en">Aircraft civilian clothing</dc:subject><dc:subject xml:lang="en">Headdress</dc:subject><dc:type rdf:resource="http://data.europeana.eu/concept/3360"></dc:type><dc:type rdf:resource="http://data.europeana.eu/concept/2397"></dc:type><dcterms:created xml:lang="de">1965-1974</dcterms:created><dcterms:created rdf:resource="#1965%2F1974"></dcterms:created><dcterms:created xml:lang="en">1965-1974</dcterms:created><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9085__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9085__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9085__technical_number_"><dc:creator xml:lang="de">Emilio Pucci (1914-1992)</dc:creator><dc:description xml:lang="de">Die Plastikhaube „Space Bubble“ („Weltraum-Blase“) gehörte zu einer Kollektion, die der italienische Modemacher Emilio Pucci für die Stewardessen der amerikanischen Fluggesellschaft Braniff International entworfen hatte. Sie sollte die Frisuren auf dem Weg zwischen Flughafengebäude und Flugzeug vor Wind und Wetter schützen. Ihren Namen verdankt sie der Ähnlichkeit mit einem Astronautenhelm.&lt;br />
Die Haube fand kaum Verwendung, da das Plastik leicht kaputt ging und die sperrigen Helme sich im Flugzeug schlecht verstauen ließen. Außerdem erfolgte der Einstieg in die Maschine zunehmend über Fluggastbrücken, die bis ins Flughafengebäude führten und den Frisurenschutz überflüssig machten.  (Deutsches Technikmuseum)</dc:description><dc:format xml:lang="de">Plastik</dc:format><dc:identifier>1/2010/1823 0 (inventory number)</dc:identifier><dc:identifier>9085 (technical number)</dc:identifier><dc:rights>Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="de">Luftfahrt</dc:subject><dc:subject xml:lang="de">Luftfahrt-Zivilkleidung</dc:subject><dc:subject xml:lang="de">Kopfbedeckung</dc:subject><dc:title xml:lang="de">Frisurenschutzhaube "Space Bubble"</dc:title><dc:type xml:lang="de">Luftfahrt</dc:type><dc:type xml:lang="de">Luftfahrt-Zivilkleidung</dc:type><dc:type xml:lang="de">Kopfbedeckung</dc:type><dc:type xml:lang="de">Man-made object</dc:type><dc:type xml:lang="de">Luft- und Raumfahrt</dc:type><dc:type xml:lang="en">Aviation</dc:type><dc:type xml:lang="en">Headgear</dc:type><dcterms:created>1965-1974</dcterms:created><dcterms:extent>Objektmaß TxBxH: 26 x 30 x 34 cm</dcterms:extent><dcterms:provenance>Deutsches Technikmuseum, Berlin</dcterms:provenance><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9085__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9085__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9085__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9085__technical_number_"/><edm:datasetName>2064129_ Stiftung Deutsches Technikmuseum Berlin</edm:datasetName><edm:c