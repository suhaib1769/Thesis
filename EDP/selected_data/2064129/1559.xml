01/XMLSchema#hexBinary">#DCDCDC</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#2F4F4F</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#000000</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#C0C0C0</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#D3D3D3</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#A9A9A9</edm:componentColor><ebucore:orientation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">landscape</ebucore:orientation></edm:WebResource><edm:WebResource rdf:about="http://www.museum-digital.de/data/berlin/images/import_17/201601/100h_29193943719.jpg"/><edm:TimeSpan rdf:about="#1915%2F1925"><skos:prefLabel xml:lang="zxx">1915/1925</skos:prefLabel><dcterms:isPartOf rdf:resource="http://data.europeana.eu/timespan/20"></dcterms:isPartOf><edm:begin>1915-01-01</edm:begin><edm:end>1925-12-31</edm:end></edm:TimeSpan><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9183__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9183__technical_number_"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502122"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.museum-digital.de/berlin/index.php?t=objekt&amp;oges=9183"/><edm:isShownBy rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193943719.jpg"/><edm:object rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193943719.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671142"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by/4.0/"/><edm:intermediateProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510547"></edm:intermediateProvider></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9183__technical_number_"><dc:description xml:lang="en">The machine works just like a hosiery, except that metal threads, instead of cotton or similar, are entangled.&lt;br/>
The tongue needles are pushed up one after the other, via guide triangles, for mesh formation. The needle opens, the thread is placed in it, the needle is closed and removed by the previous stitch.&lt;br/>
&lt;br/>
The foundation stone of the Leonese industry was built in the 16th century. Anthoni Fournier was the founder of this branch of industry, which dates back to the French town of Lyon. This formed a center of web art and produced a special web procedure. The weavers used gilded threads as well as silver-plated threads for the production of brushes and textile. This method was also used in Roth. Borders and other interlacing were produced from silver plated or galvanized copper wires. &lt;br/>
An important industrial location was built around the city, where the successor of the Leonese industry, today’s LEONI AG, is based. The company produces wires, optical fibers, cables and cable systems.  (Deutsches Technikmuseum)</dc:description><dc:format xml:lang="en">Wood, metal</dc:format><dc:rights xml:lang="de">Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="en">Textile technology</dc:subject><dc:subject xml:lang="en">weaving</dc:subject><dc:subject xml:lang="en">copper wire</dc:subject><dc:title xml:lang="en">Pot scratching machine, Leonese industry</dc:title><dcterms:created xml:lang="de">1915-1925</dcterms:created><dcterms:created rdf:resource="#1915%2F1925"></dcterms:created><dcterms:created xml:lang="en">1915-1925</dcterms:created><dcterms:extent xml:lang="de">Objektmaß LxBxH: 1810 x 690 x 1520 mm; Masse: 190 kg</dcterms:extent><dcterms:extent xml:lang="en">Object dimension LxBxH: 1810 x 690 x 1520 mm; mass: 190 kg</dcterms:extent><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9183__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9183__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9183__technical_number_"><dc:description xml:lang="de">Die Maschine arbeitet genauso wie eine Strumpfstrickmaschine, nur dass Metallfäden, statt Baumwolle oder ähnlichem verstrickt werden.&lt;br />
Die Zungennadeln werden nacheinander, über Führungsdreiecke, zur Maschenbildung nach oben geschoben. Die Nadel öffnet sich, der Faden wird hineingelegt, die Nadel geschlossen und durch die vorangegangene Masche nach unten abgezogen.&lt;br />
&lt;br />
Der Grundstein der Leonischen Industrie entstand im 16. Jh. Anthoni Fournier war Begründer dieses Industriezweiges, welche im Namensursprung auf den französischen Ort Lyon zurückgeht. Diese bildete ein Zentrum der Webkunst und brachte ein besonderes Webverfahren hervor. Zur Herstellung von Gespinste und Gewebe verwendeten die Weber vergoldete, sowie versilberte Fäden. Dieses Verfahren wurde auch in Roth angewandt. Borten und andere Geflechte wurden aus versilberten oder verzinkten Kupferdrähten produziert. &lt;br />
Rund um die Stadt entstand ein wichtiger Industriestandort, in dem der Nachfolger der Leonischen Industrie, die heutige LEONI AG, ihren Sitz hat. Die Firma erzeugt Drähte, optische Fasern, Kabel und Kabelsysteme.  (Deutsches Technikmuseum)</dc:description><dc:format xml:lang="de">Holz, Metall</dc:format><dc:identifier>1/1989/0715 0  (inventory number)</dc:identifier><dc:identifier>9183 (technical number)</dc:identifier><dc:rights>Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="de">Textiltechnik</dc:subject><dc:subject xml:lang="de">Weben</dc:subject><dc:subject xml:lang="de">Kupferdraht</dc:subject><dc:title xml:lang="de">Topfkratzermaschine, Leonische Industrie</dc:title><dc:type xml:lang="de">Textiltechnik</dc:type><dc:type xml:lang="de">Weben</dc:type><dc:type xml:lang="de">Kupferdraht</dc:type><dc:type xml:lang="de">Man-made object</dc:type><dc:type xml:lang="de">Textiltechnik</dc:type><dc:type xml:lang="en">Weaving</dc:type><dc:type xml:lang="en">copper wire</dc:type><dcterms:created>1915-1925</dcterms:created><dcterms:extent>Objektmaß LxBxH: 1810 x 690 x 1520 mm; Masse: 190 kg</dcterms:extent><dcterms:provenance>Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:spatial>Roth</dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9183__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9183__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9183__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9183__technical_number_"/><edm:datasetName>2064129_ Stiftung Deutsches Technikmuseum Berlin</edm:datasetName><edm:country>Germany</edm:country><edm:preview rdf:r