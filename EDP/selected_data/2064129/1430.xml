CHO_museum_digital_9054__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9054__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9054__technical_number_"><dc:description xml:lang="en">Wood made bars for children’s shoes in size 16. The bar gives the shoe its final shape. There are different bars for each size and shape. After a shoe has been completed, the molding is removed and a next pair can be made. To this end, many bars are dismantled.  (Deutsches Technikmuseum)</dc:description><dc:format rdf:resource="http://data.europeana.eu/concept/1816"></dc:format><dc:format xml:lang="en">wood</dc:format><dc:rights xml:lang="de">Deutsches Technikmuseum</dc:rights><dc:subject xml:lang="en">Bars (shoe making)</dc:subject><dc:title xml:lang="en">Traces for children’s shoes</dc:title><dcterms:extent xml:lang="de">Objektmaß LxBxH: 165 x 60 x 65 mm; Masse: 0,14 kg; Konfektionsgröße: 16</dcterms:extent><dcterms:extent xml:lang="en">Object dimension LxBxH: 165 x 60 x 65 mm; mass: 0.14 kg; jam size: 16</dcterms:extent><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9054__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9054__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9054__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9054__te