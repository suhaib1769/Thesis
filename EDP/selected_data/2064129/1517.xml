rdf:resource="http://purl.org/bncf/tid/16721"/><skos:exactMatch rdf:resource="https://www.freebase.com/m/0d1pc"/><skos:exactMatch rdf:resource="https://g.co/kg/m/0d1pc"/><skos:exactMatch rdf:resource="http://datos.bne.es/resource/XX538551"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300025848"/><skos:exactMatch rdf:resource="http://iconclass.org/41D121"/><skos:exactMatch rdf:resource="http://www.yso.fi/onto/yso/p27565"/><skos:exactMatch rdf:resource="http://babelnet.org/rdf/s00033735n"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Model_(person)"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/2064129/Museu_ProvidedCHO_museum_digital_9141__technical_number_"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9141__technical_number_"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502122"></edm:dataProvider><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193640707.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193640780.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/100h_29193640707.jpg"/><edm:hasView rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/100h_29193640780.jpg"/><edm:isShownAt rdf:resource="http://www.museum-digital.de/berlin/index.php?t=objekt&amp;oges=9141"/><edm:isShownBy rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193640605.jpg"/><edm:object rdf:resource="http://www.museum-digital.de/data/berlin/images/import_17/201601/29193640605.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671142"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by/4.0/"/><edm:intermediateProvider rdf:resource="http://data.europeana.eu/organization/1482250000004510547"></edm:intermediateProvider></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/2064129/Museu_ProvidedCHO_museum_digital_9141__technical_number_"><dc:creator xml:lang="en">Railway main workshop in Wroclaw</dc:creator><dc:description xml:lang="en">From 1889 to 1897 the Royal Prussian State Railways (K.P.St.E.) procured 88 locomotives of the later genera T 2 and T 4.2 for light passenger trains. The machines were able to accelerate a 320-ton carriage train in the plain to 60 km/h. Despite the maximum speed of 75 km/h, they soon migrated to the subway service, where they stayed until the 1920s. The locomotive “Breslau 1458” was built in 1897 near Schichau in Elbing. In 1905 the main workshop in Breslau produced a sub-model for the Berlin Transport and Construction Museum. The workshop Michael John completed the base frame in 1985.&lt;br/>
&lt;br/>
Traffic and construction museum. Official guide through the collections/Transport and Construction Museum Berlin. Berlin: Elsner, 1943. P. 67 &lt;br/>
Nussbaum, Uwe. Railway models: treasures from the Transport and Construction Museum. Berlin: Nicolai, 1998. No. 12 (Deutsches Technikmuseum)</dc:description><dc:rights xml:lang="de">Deutsches Technikmuseum</dc:rights><dc:subject rdf:resource="http://data.europeana.eu/concept/1954"></dc:subject><dc:subject xml:lang="en">Rail traffic</dc:subject><dc:subject xml:lang="en">Railway vehicles with propulsion</dc:subject><dc:subject xml:lang="en">Train</dc:subject><dc:type rdf:resource="http://data.europeana.eu/concept/1954"></dc:type><dcterms:created rdf:resource="#1889"></dcterms:created><dcterms:created xml:lang="zxx">1889</dcterms:created><dcterms:provenance xml:lang="de">Deutsches Technikmuseum, Berlin</dcterms:provenance><dcterms:provenance xml:lang="en">Deutsches Technikmuseum, Berlin</dcterms:provenance><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1889</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/2064129/Museu_ProvidedCHO_museum_digital_9141__technical_number_"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/2064129/Museu_ProvidedCHO_museum_digital_9141__technical_number_"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/2064129/Museu_ProvidedCHO_museum_digital_9141__technical_number_"><dc:creator xml:lang="de">Eisenbahn-Hauptwerkstätte Breslau</dc:creator><dc:description xml:lang="de">Von 1889 bis 1897 beschafften die Königlich Preußische Staatseisenbahnen (K.P.St.E.) für leichte Personenzüge 88 Lokomotiven der späteren Gattungen T 2 und T 4.2 „Elberfelder Bauart“. Die Maschinen konnten einen 320-Tonnen-Wagenzug in der Ebene auf 60 km/h beschleunigen. Trotz der Höchstgeschwindigkeit von 75 km/h wanderten sie bald in den Nebenbahndienst ab, wo sie sich bis in die 1920er Jahre hielten. Die Lok „Breslau 1458“ entstand 1897 bei Schichau in Elbing. Von ihr fertigte die Hauptwerkstätte Breslau 1905 ein Teilmodell für das Berliner Verkehrs- und Baumuseum. Die Werkstatt Michael John komplettierte 1985 das Untergestell.&lt;br />
&lt;br />
