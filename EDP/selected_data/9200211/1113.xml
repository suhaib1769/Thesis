inting upon, drawing or for packaging</skos:note><skos:note xml:lang="it">Materiale igroscopico, costituito da materie prime fibrose</skos:note><skos:note xml:lang="fr">Matière fabriquée à partir de fibres cellulosiques végétales et animales</skos:note><skos:note xml:lang="es">Delgada hoja elaborada con pasta de fibras vegetales</skos:note><skos:note xml:lang="cs">Tenký, pružný, vláknitý materiál s minerálními přísadami, vyráběný převážně z celulózy, užívaný pro psaní, kreslení, tisk nebo k balení</skos:note><skos:note xml:lang="sk">Tenký, hladký materiál vyrábaný zhutnením vlákna</skos:note><skos:note xml:lang="pl">Podłoże pisarskie lub malarskie otrzymywane z makulatury, celulozy i włókien innych roślin</skos:note><skos:note xml:lang="da">Materiale man kan skrive og tegne på</skos:note><skos:note xml:lang="nl">Materiaal waarop kan worden geschreven en getekend en dat kan worden bedrukt door middel van een druktechniek</skos:note><skos:note xml:lang="ca">Làmina constituïda per un entramat tridimensional de fibres de cel·lulosa i altres substàncies</skos:note><skos:broader rdf:resource="http://data.europeana.eu/concept/2069"/><skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q11472"/><skos:exactMatch rdf:resource="https://d-nb.info/gnd/4044522-7"/><skos:exactMatch rdf:resource="http://id.loc.gov/authorities/names/sh85097578"/><skos:exactMatch rdf:resource="http://data.bnf.fr/ark:/12148/cb11949744d"/><skos:exactMatch rdf:resource="http://id.ndl.go.jp/auth/ndlna/00564806"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/D010209"/><skos:exactMatch rdf:resource="http://purl.org/bncf/tid/1192"/><skos:exactMatch rdf:resource="https://www.freebase.com/m/0641k"/><skos:exactMatch rdf:resource="https://g.co/kg/m/0641k"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300014109"/><skos:exactMatch rdf:resource="http://iconclass.org/49L641"/><skos:exactMatch rdf:resource="http://www.yso.fi/onto/yso/p8522"/><skos:exactMatch rdf:resource="http://babelnet.org/rdf/s00060464n"/><skos:exactMatch rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10574"/><skos:exactMatch rdf:resource="http://zbw.eu/stw/descriptor/14802-1"/><skos:exactMatch rdf:resource="http://vocabularies.unesco.org/thesaurus/concept14922"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Paper"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_fmb_ms_Napoleon_N_004_001"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_fmb_ms_Napoleon_N_004_001"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502183"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.e-codices.unifr.ch/en/list/one/fmb/ms-Napoleon-N-004-001"/><edm:isShownBy rdf:resource="http://www.e-codices.unifr.ch/loris/fmb/fmb-ms-Napoleon-N-004-001/fmb-ms-Napoleon-N-004-001_001r.jp2/full/full/0/default.jpg"/><edm:object rdf:resource="http://www.e-codices.unifr.ch/loris/fmb/fmb-ms-Napoleon-N-004-001/fmb-ms-Napoleon-N-004-001_001r.jp2/full/full/0/default.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671163"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/9200211/en_list_one_fmb_ms_Napoleon_N_004_001"><dc:date rdf:resource="#1818"></dc:date><dcterms:medium rdf:resource="http://data.europeana.eu/concept/2090"></dcterms:medium><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1818</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_fmb_ms_Napoleon_N_004_001"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_fmb_ms_Napoleon_N_004_001"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_fmb_ms_Napoleon_N_004_001"><dc:creator>Napoléon I.</dc:creator><dc:date>1818</dc:date><dc:description>During his exile on St. Helena, Napoleon (1769-1821) availed himself of a library of 3,000 books — a poor remedy for boredom. Nevertheless, the deposed emperor found pleasure in reading and annotating ancient and modern classics. As a theater enthusiast, he read aloud Voltaire’s La Mort de César to his entourage several times. He decided to write his own play on the same subject; this manuscript in Napoleon’s own handwriting presents a quick sketch of the first two scenes. On page 3, tired of his subject, the emperor covers the page with strategic and military calculations, having frigates engage with regiments and artillery.</dc:description><dc:format>3 pp., 20.5 x 31 cm</dc:format><dc:identifier>doi:10.5076/e-codices-fmb-ms-Napoleon-N-004-001</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/fmb/ms-Napoleon-N-004-001</dc:identifier><dc:identifier>Cologny, Fondation Martin Bodmer, N-4.1</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>French</dc:language><dc:rights>e-codices / Cologny, Fondation Martin Bodmer (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/fmb/ms-Napoleon-N-004-001"></dc:source><dc:title>Cologny, Fondation Martin Bodmer, N-4.1 : Napoleon, César, autograph</dc:title><dc:type>Autograph</dc:type><dcterms:medium>Paper</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_fmb_ms_Napoleon_N_004_001"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_fmb_ms_Napoleon_N_004_001"/><edm:type>TEXT</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_fmb_ms_Napoleon_N_004_001"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_l