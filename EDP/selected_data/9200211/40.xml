zation/1482250000004502183"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.e-codices.unifr.ch/en/list/one/bbb/0250"/><edm:isShownBy rdf:resource="http://www.e-codices.unifr.ch/loris/bbb/bbb-0250/bbb-0250_001r.jp2/full/full/0/default.jpg"/><edm:object rdf:resource="http://www.e-codices.unifr.ch/loris/bbb/bbb-0250/bbb-0250_001r.jp2/full/full/0/default.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671163"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_bbb_0250"><dc:coverage>Part I (ff. 1-12): Germany: Seligenstadt; Part II (ff. 13-28): France: Fleury</dc:coverage><dc:creator>Victorius, Aquitanus</dc:creator><dc:creator>Helpericus, Altissiodorensis</dc:creator><dc:creator>Bongars, Jacques</dc:creator><dc:creator>Ausonius, Decimus Magnus</dc:creator><dc:creator>Silvester II, Papa</dc:creator><dc:creator>Abbo, Floriacensis</dc:creator><dc:creator>Gravisset, Jakob von</dc:creator><dc:date>Part I (f. 1-12): around 836; Part II (f. 13-28): around 1000</dc:date><dc:description>The manuscript consists of two parts. The first, Carolingian (fol. 1–12) with its original texts (fol. 1v–11v), reflects a meeting between Einhard and Lupus of Ferrières that occurred in June of 836 in Seligenstadt. Lupus received the arithmetic book (Calculus) by Victorius of Aquitaine along with a now widely known model alphabet for Ancient Capitals. Around 1000, texts by Abbo of Fleury on the ‘computus’ (reckoning the date for Easter) were then added at the abbot’s home monastery on the Loire (fol. 12–28), along with an abacus table (fol. 1r). The resulting collection of documents contains key items for and from Abbo's technical scholarship and offers a slightly divergent counterpart to the contemporaneous Floriacensis, Berlin, Staatsbibl., Phill. 1833.</dc:description><dc:format>28 ff., Teil I: 28.5-29 x 22.5-23 cm / Teil II: 27.5-28 x 23 cm</dc:format><dc:identifier>doi:10.5076/e-codices-bbb-0250</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/bbb/0250</dc:identifier><dc:identifier>Bern, Burgerbibliothek, Cod. 250</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Latin</dc:language><dc:relation>Homburger, Otto: Die illustrierten Handschriften der Burgerbibliothek Bern, Bd. II (Bern, um 1960) [unpubliziertes Typoskript]. Redigiert und ergänzt von Michael I. Allen und Florian Mittenhuber, Oktober 2014.</dc:relation><dc:rights>e-codices / Bern, Burgerbibliothek (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/bbb/0250"></dc:source><dc:title>Bern, Burgerbibliothek, Cod. 250 : Victorinus Aquitanus: Calculus; Abbo Floriacensis: Computus</dc:title><dc:type>Manuscript</dc:type><dcterms:medium>Parchment</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bbb_0250"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_bbb_0250"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/9200211/en_list_one_bbb_0250"><dc:creator rdf:resource="http://data.europeana.eu/agent/171312"></dc:creator><dc:type rdf:resource="http://data.europeana.eu/concept/17"></dc:type><dcterms:medium rdf:resource="http://data.europeana.eu/concept/2092"></dcterms:medium><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bbb_0250"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_bbb_0250"/><edm:type>TEXT</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_bbb_0250"><edm:aggregatedCHO rdf:r