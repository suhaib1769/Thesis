:creator><dc:creator>Eucherius, Lugdunensis</dc:creator><dc:date>after 650</dc:date><dc:description>The sole papyrus manuscript held by the Abbey Library of St. Gall. The 23 pages, written after 650 in southern France, contain the closing of the second chapter of the Synonyma of Isidore of Seville as well as two exhortations aimed at monks. After being preserved over a very long period in a wooden case, these 23 pages were mounted between two glass plates in the Egyptian Museum of Berlin in 1899/1900.</dc:description><dc:format>44 pp., 18 x 14 cm</dc:format><dc:identifier>doi:10.5076/e-codices-csg-0226</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/csg/0226</dc:identifier><dc:identifier>St. Gallen, Stiftsbibliothek, Cod. Sang. 226</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Latin</dc:language><dc:relation>Scherrer Gustav, Verzeichniss der Handschriften der Stiftsbibliothek von St. Gallen, Halle 1875, S. 81-82.</dc:relation><dc:rights>e-codices / St. Gallen, Stiftsbibliothek (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/csg/0226"></dc:source><dc:title>St. Gallen, Stiftsbibliothek, Cod. Sang. 226 : Isidori Synonyma II, Humilia ad monachos, Sermo Eucherii</dc:title><dc:type>Manuscript</dc:type><dcterms:medium>Papyrus</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_0226"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_csg_0226"/><edm:type>TEXT</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_csg_0226"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_0226"/><edm:datasetName>9200211_Ag_EU_e-Codices</edm:datasetName><edm:country>Switzerland</edm:coun