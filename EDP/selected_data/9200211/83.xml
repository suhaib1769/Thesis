/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Manuscript"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_bc_b_0242"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bc_b_0242"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502183"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.e-codices.unifr.ch/en/list/one/bc/b-0242"/><edm:isShownBy rdf:resource="http://www.e-codices.unifr.ch/loris/bc/bc-b-0242/bc-b-0242_001v.jp2/full/full/0/default.jpg"/><edm:object rdf:resource="http://www.e-codices.unifr.ch/loris/bc/bc-b-0242/bc-b-0242_001v.jp2/full/full/0/default.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671163"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_bc_b_0242"><dc:coverage>Worms, Juspa shammes</dc:coverage><dc:creator>Yiftaḥ Yozpa Ben-Naftali ha-Leṿi</dc:creator><dc:date>[17th century]</dc:date><dc:description>Joseph (Juspa), shammes of Worms (1604-1678), recorded the everyday life, the rites and the customs of the Jewish community in Worms, one of the oldest and most important in all of Europe. This autograph manuscript contains commentaries on the prayer book, on the Birkat Hamason ("Grace after Meals"), on the Haggadah and on the Pirkei Avot  ("Sayings of the Fathers") as well as prayer-related customs and autobiographical remarks. The comments on Minhagim ("customs") were incorporated into the printed edition of the Wormser Minhagbuch, but large parts of this manuscript remain unpublished and serve as an important source for the religious history of one of the most significant Jewish communities in Europe. This manuscript belonged to, among others, Rabbi Michael Scheyer; later it was part of the private library of Salman Schocken in Jerusalem.</dc:description><dc:format>164 ff., 20 x 15.4 cm</dc:format><dc:identifier>doi:10.5076/e-codices-bc-b-0242</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/bc/b-0242</dc:identifier><dc:identifier>Zürich, Braginsky Collection, B242</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Hebrew</dc:language><dc:rights>e-codices / Zürich, Braginsky Collection (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/bc/b-0242"></dc:source><dc:title>Zürich, Braginsky Collection, B242 : Juspa (Jousep), &lt;i>Sefer Likkutei Yosef&lt;/i> ("Joseph’s Compilation")</dc:title><dc:type>Manuscript</dc:type><dcterms:medium>Parchment</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bc_b_0242"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_bc_b_0242"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/9200211/en_list_one_bc_b_0242"><dc:date rdf:resource="#16XX"></dc:date><dc:date rdf:resource="http://data.europeana.eu/timespan/17"></dc:date><dc:type rdf:resource="http://data.europeana.eu/concept/17"></dc:type><dcterms:medium rdf:resource="http://data.europeana.eu/concept/2092"></dcterms:medium><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bc_b_0242"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_bc_b_0242"/><edm:type>TEXT</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_bc_b_0242"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bc_b_0242"/><edm:datasetName>9200211_Ag_EU_e-Codices</edm:datasetName><edm