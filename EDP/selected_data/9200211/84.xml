oxy rdf:about="http://data.europeana.eu/proxy/europeana/9200211/en_list_one_bc_b_0217"><dc:coverage rdf:resource="http://data.europeana.eu/place/81222"></dc:coverage><dc:coverage rdf:resource="http://data.europeana.eu/place/73"></dc:coverage><dc:date rdf:resource="#1751"></dc:date><dc:type rdf:resource="http://data.europeana.eu/concept/17"></dc:type><dcterms:medium rdf:resource="http://data.europeana.eu/concept/2092"></dcterms:medium><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1751</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bc_b_0217"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_bc_b_0217"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_bc_b_0217"><dc:coverage>Deutschkreutz</dc:coverage><dc:date>1751</dc:date><dc:description>In addition to the Seder Birkat ha-Mazon ("Grace after Meals"), this mid-18th century manuscript contains the Birkhot ha-Nehenin ("Blessings over Enjoyments"), the Shalosh Mitzvot Nashim ("Three Commandments for Women") and the Seder Keri’at Shema al ha-Mittah ("Reading of the Shema before retiring at night"). The passages relating to the three commandments imposed on women indicate that the book was meant as a bridal gift. Besides the image on the front page, the book contains 22 smaller colored illustrations. A Hebrew phrase on the the title page refers to the place of origin, Deutschkreutz in Burgenland (Austria). Based on stylistic characteristics of the script and decoration, the manuscript can be attributed to the scribe and illustrator Aaron Wolf Herlingen.</dc:description><dc:format>24 ff., 9.5 x 5.2 cm</dc:format><dc:identifier>doi:10.5076/e-codices-bc-b-0217</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/bc/b-0217</dc:identifier><dc:identifier>Zürich, Braginsky Collection, B217</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Hebrew</dc:language><dc:rights>e-codices / Zürich, Braginsky Collection (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/bc/b-0217"></dc:source><dc:title>Zürich, Braginsky Collection, B217 : &lt;i>Seder Birkat ha-Mazon&lt;/i> (Grace after Meals and other prayers and blessings)</dc:title><dc:type>Manuscript</dc:type><dcterms:medium>Parchment</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bc_b_0217"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_bc_b_0217"/><edm:type>TEXT</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_bc_b_0217"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bc_b_0217"/><edm:datasetName>9200211_Ag_EU_e-Codices</edm:datasetName><edm:country>Switzerland</edm:country><edm:preview rdf:resource="http://www.e-codices.unifr.ch/loris/bc/bc-b-0217/bc-b-0217_001r.jp2/full/full/0/default.jpg"/><edm:landingPage rdf:resource="https://www.europeana.eu/item/9200211/en_list_one_bc_b_0217"/><edm:language>mul</edm:language><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/><edm:completeness>10</edm:completeness><dcterms:created>2016-09-09T12:15:39.923Z</dcterms:created><dcterms:modified>2016-09-27T09:29:52.461Z</dcterms:modified><dqv:hasQualityAnnotation rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bc_b_0217#contentTier"/><dqv:hasQualityAnnotation rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bc_b_0217#metadataTier"/></edm:EuropeanaAggregation><foaf:Organization rdf:about="http://data.europeana.eu/organization/1482250000004671163"><skos:prefLabel xml:lang="en">University of Fribourg</skos:prefLabel></foaf:Organization><foaf:Organi