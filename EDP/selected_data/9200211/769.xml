p://creativecommons.org/licenses/by-nc/3.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/9200211/en_list_one_csg_0645"><dc:date rdf:resource="#15XX"></dc:date><dc:date rdf:resource="http://data.europeana.eu/timespan/16"></dc:date><dc:type rdf:resource="http://data.europeana.eu/concept/17"></dc:type><dcterms:medium rdf:resource="http://data.europeana.eu/concept/2090"></dcterms:medium><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_0645"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_csg_0645"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_csg_0645"><dc:creator>Schlapperitzin, Konrad</dc:creator><dc:creator>Brant, Sebastian</dc:creator><dc:creator>Tschudi, Aegidius</dc:creator><dc:date>16th century</dc:date><dc:description>A copy made in 1520 of the so-called "Klingenberger Chronik" (Klingenberg Chronicle) originally composed in 1450. It is the history of the Appenzell Wars (1401-1429) and of the Old Zurich War (1440-1446) from the point of view of the losing side: the eastern Swiss nobility. Illustrated with several color sketches of battle scenes and coats of arms. In addition this codex contains copies of legal documents, chronological notes, songs, and in the very front an incompletely preserved 1520 Strasbourg print edition by Sebastian Brant (1457/58-1521) of the biographies of Roman emperors Titus and Vespasian. This volume was obtained by the Abbey Library of St. Gall from Glarus humanities scholar Aegidius Tschudi (1505-1572) in 1768.</dc:description><dc:format>654 pp., 30-30.5 x 21 cm</dc:format><dc:identifier>doi:10.5076/e-codices-csg-0645</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/csg/0645</dc:identifier><dc:identifier>St. Gallen, Stiftsbibliothek, Cod. Sang. 645</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>German</dc:language><dc:relation>Scarpatetti Beat Matthias von, Die Handschriften der Stiftsbibliothek St. Gallen, Bd. 1: Abt. IV: Codices 547-669: Hagiographica, Historica, Geographica, 8.-18. Jahrhundert, Wiesbaden 2003, S. 275-279.</dc:relation><dc:rights>e-codices / St. Gallen, Stiftsbibliothek (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/csg/0645"></dc:source><dc:title>St. Gallen, Stiftsbibliothek, Cod. Sang. 645 : Sebastian Brant's Panegyric to Trajan · the so-called "Klingenberger Chronik" · Songs of battle and vilification</dc:title><dc:type>Manuscript</dc:type><dcterms:medium>Paper</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_0645"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_csg_0645"/><edm:type>TEXT</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_csg_0645"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_0645"/><edm:datasetName>9200211_Ag_EU_e-Codices</edm:datasetName><edm:country>Switzerland</edm:country><edm:preview rdf:resource="http://www.e-codices.unifr.ch/loris/csg/csg-0645/csg-0645_009.jp2/full/full/0/default.jpg"/><edm:landingPage rdf:resource="https://www.europeana.eu/item/9200211/en_list_one_csg_0645"/><edm:language>mul</edm:language><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/><edm:completeness>10</edm:completeness><dcterms:created>2016-09-09T12:27:00.957Z</dcterms:created><dcterms:modified>2016-09-27T09:30:05.752Z</dcterms:modified><dqv:hasQualityAnnotation rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_0645#contentTier"/><dqv:hasQualityAnnotation rdf:resource="http://data.e