ang="el">Χαρτί</skos:prefLabel><skos:prefLabel xml:lang="en">Paper</skos:prefLabel><skos:prefLabel xml:lang="it">Carta</skos:prefLabel><skos:prefLabel xml:lang="es">Papel</skos:prefLabel><skos:prefLabel xml:lang="et">Paber</skos:prefLabel><skos:prefLabel xml:lang="eu">Paper</skos:prefLabel><skos:prefLabel xml:lang="cs">Papír</skos:prefLabel><skos:prefLabel xml:lang="pl">Papier</skos:prefLabel><skos:prefLabel xml:lang="ro">Hârtie</skos:prefLabel><skos:prefLabel xml:lang="da">Papir</skos:prefLabel><skos:prefLabel xml:lang="nl">Papier</skos:prefLabel><skos:note xml:lang="de">Werkstoff aus Fasern zum Beschreiben, Bedrucken und Verpacken</skos:note><skos:note xml:lang="fi">Ohut kuiduista tehty materiaali</skos:note><skos:note xml:lang="sv">Cellulosabaserat material</skos:note><skos:note xml:lang="ru">Волокнистый материал с минеральными добавками</skos:note><skos:note xml:lang="pt">Folha fina feita com pasta de fibras vegetais</skos:note><skos:note xml:lang="en">Thin, flexible material mainly used for writing upon, printing upon, drawing or for packaging</skos:note><skos:note xml:lang="it">Materiale igroscopico, costituito da materie prime fibrose</skos:note><skos:note xml:lang="fr">Matière fabriquée à partir de fibres cellulosiques végétales et animales</skos:note><skos:note xml:lang="es">Delgada hoja elaborada con pasta de fibras vegetales</skos:note><skos:note xml:lang="cs">Tenký, pružný, vláknitý materiál s minerálními přísadami, vyráběný převážně z celulózy, užívaný pro psaní, kreslení, tisk nebo k balení</skos:note><skos:note xml:lang="sk">Tenký, hladký materiál vyrábaný zhutnením vlákna</skos:note><skos:note xml:lang="pl">Podłoże pisarskie lub malarskie otrzymywane z makulatury, celulozy i włókien innych roślin</skos:note><skos:note xml:lang="da">Materiale man kan skrive og tegne på</skos:note><skos:note xml:lang="nl">Materiaal waarop kan worden geschreven en getekend en dat kan worden bedrukt door middel van een druktechniek</skos:note><skos:note xml:lang="ca">Làmina constituïda per un entramat tridimensional de fibres de cel·lulosa i altres substàncies</skos:note><skos:broader rdf:resource="http://data.europeana.eu/concept/2069"/><skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q11472"/><skos:exactMatch rdf:resource="https://d-nb.info/gnd/4044522-7"/><skos:exactMatch rdf:resource="http://id.loc.gov/authorities/names/sh85097578"/><skos:exactMatch rdf:resource="http://data.bnf.fr/ark:/12148/cb11949744d"/><skos:exactMatch rdf:resource="http://id.ndl.go.jp/auth/ndlna/00564806"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/D010209"/><skos:exactMatch rdf:resource="http://purl.org/bncf/tid/1192"/><skos:exactMatch rdf:resource="https://www.freebase.com/m/0641k"/><skos:exactMatch rdf:resource="https://g.co/kg/m/0641k"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300014109"/><skos:exactMatch rdf:resource="http://iconclass.org/49L641"/><skos:exactMatch rdf:resource="http://www.yso.fi/onto/yso/p8522"/><skos:exactMatch rdf:resource="http://babelnet.org/rdf/s00060464n"/><skos:exactMatch rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10574"/><skos:exactMatch rdf:resource="http://zbw.eu/stw/descriptor/14802-1"/><skos:exactMatch rdf:resource="http://vocabularies.unesco.org/thesaurus/concept14922"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Paper"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_fmb_ms_Hoelderlin_H_051_004"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_fmb_ms_Hoelderlin_H_051_004"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502183"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.e-codices.unifr.ch/en/list/one/fmb/ms-Hoelderlin-H-051-004"/><edm:isShownBy rdf:resource="http://www.e-codices.unifr.ch/loris/fmb/fmb-ms-Hoelderlin-H-051-004/fmb-ms-Hoelderlin-H-051-004_001.jp2/full/full/0/default.jpg"/><edm:object rdf:resource="http://www.e-codices.unifr.ch/loris/fmb/fmb-ms-Hoelderlin-H-051-004/fmb-ms-Hoelderlin-H-051-004_001.jp2/full/full/0/default.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671163"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_fmb_ms_Hoelderlin_H_051_004"><dc:date>1843 / (20.01.1756)</dc:date><dc:description>This poem in two stanzas of four lines each and titled “Der Frühling,” was written by Friedrich Hölderlin (1770-1843) in his own hand; at the end it is signed “Mit Unterthänigkeit Scardanelli” and dated to January 20, 1756. Hölderlin, who from about 1802 on was mentally ill, often signed his works, sometimes with invented names, among them Scardanelli, and invented dates. Another hand has corrected the given date in pencil to 1843; this suggests that the poem was created shortly before Hölderlin’s death.</dc:description><dc:format>1 f., 32.5 x 21 cm</dc:format><dc:identifier>doi:10.5076/e-codices-fmb-ms-Hoelderlin-H-051-004</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/fmb/ms-Hoelderlin-H-051-004</dc:identifier><dc:identifier>Cologny, Fondation Martin Bodmer, H-51.4</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>German</dc:language><dc:rights>e-codices / Cologny, Fondation Martin Bodmer (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/fmb/ms-Hoelderlin-H-051-004"></dc:source><dc:title>Cologny, Fondation Martin Bodmer, H-51.4 : Friedrich Hölderlin, &lt;i>Der Frühling&lt;/i>, autograph</dc:title><dc:type>Autograph</dc:type><dcterms:medium>Paper</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_fmb_ms_Hoelderlin_H_051_004"/