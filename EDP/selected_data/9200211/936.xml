183"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.e-codices.unifr.ch/en/list/one/csg/2106"/><edm:isShownBy rdf:resource="http://www.e-codices.unifr.ch/loris/csg/csg-2106/csg-2106_001r.jp2/full/full/0/default.jpg"/><edm:object rdf:resource="http://www.e-codices.unifr.ch/loris/csg/csg-2106/csg-2106_001r.jp2/full/full/0/default.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671163"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/9200211/en_list_one_csg_2106"><dc:coverage rdf:resource="http://data.europeana.eu/place/78"></dc:coverage><dc:type rdf:resource="http://data.europeana.eu/concept/17"></dc:type><dcterms:medium rdf:resource="http://data.europeana.eu/concept/2092"></dcterms:medium><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_2106"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_csg_2106"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_csg_2106"><dc:coverage>Switzerland</dc:coverage><dc:date>probably not after the middle of the 9th century</dc:date><dc:description>These two parchment double leaves were found in 1895 by state archivist Paul Schweizer in book bindings in the State Archives of Zurich; they were held there under the shelfmark C VI 1 II 8a until 2006. As conclusion to the long-term dispute about cultural assets between St. Gall and Zurich, the Canton of Zurich donated these fragments to the Abbey Library of St. Gall on 27 April 2006. The leaves are from a passionary; they contain eleven partially fragmentary chapters of the oldest version of the life of St. Gall (Vita sancti Galli vetustissima) as well as the beginnings of the Passions of the evangelist Luke and the apostles Simon and Judas. The latter text (for October 28th) has the number 80, suggesting that the passionary once comprised more than 90 texts.</dc:description><dc:format>4 ff., 21-22 x 23 / 28-28.5 x 22.5-24 cm</dc:format><dc:identifier>doi:10.5076/e-codices-csg-2106</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/csg/2106</dc:identifier><dc:identifier>St. Gallen, Stiftsbibliothek, Cod. Sang. 2106</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Latin</dc:language><dc:relation>Beschreibung von Franziska Schnoor, Stiftsbibliothek St. Gallen, 2014.</dc:relation><dc:rights>e-codices / St. Gallen, Stiftsbibliothek (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/csg/2106"></dc:source><dc:title>St. Gallen, Stiftsbibliothek, Cod. Sang. 2106 : Fragment from a passionary: Vita sancti Galli vetustissima, Laudatio Lucae evangelistae, Passio Simonis et Iudae apostolorum</dc:title><dc:type>Manuscript</dc:type><dcterms:medium>Parchment</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_2106"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_csg_2106"/><edm:type>TEXT</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_csg_2106"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_2106"/><edm:datasetName>9200211_Ag_EU_e-Codices</edm:datasetName><edm:country>Switzerland</edm:country><edm:preview rdf:resource="http://www.e-codices.unifr.ch/loris/csg/csg-2106/csg-2106_001r.jp2/full/full/0/default.jpg"/><edm:landingPage rdf:resource="https://www.europeana.eu/item/9200211/en_list_one_csg_2106"/><edm:language>mul</edm:language><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"