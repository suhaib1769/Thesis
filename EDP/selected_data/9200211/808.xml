ity, the “Epistula de febribus” by the Greek physician Galen († 216 AD), and a “Liber medicinalis” by an unknown author.</dc:description><dc:format>94 ff., 21.5 x 16.5 cm</dc:format><dc:identifier>doi:10.5076/e-codices-csg-0759</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/csg/0759</dc:identifier><dc:identifier>St. Gallen, Stiftsbibliothek, Cod. Sang. 759</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Latin</dc:language><dc:relation>Beccaria Augusto, I codici di medicina del periodo presalernitano, Roma 1956, pp. 384-386.</dc:relation><dc:rights>e-codices / St. Gallen, Stiftsbibliothek (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/csg/0759"></dc:source><dc:title>St. Gallen, Stiftsbibliothek, Cod. Sang. 759 : Collection of medical texts</dc:title><dc:type>Manuscript</dc:type><dcterms:medium>Parchment</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_0759"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_csg_0759"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/9200211/en_list_one_csg_0759"><dc:creator rdf:resource="http://data.europeana.eu/agent/168516"></dc:creator><dc:type rdf:resource="http://data.europeana.eu/concept/17"></dc:type><dcterms:medium rdf:resource="http://data.europeana.eu/concept/2092"></dcterms:medium><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_0759"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_csg_0759"/><edm:type>TEXT</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_csg_0759"><edm:agg