os:prefLabel xml:lang="el">Χαρτί</skos:prefLabel><skos:prefLabel xml:lang="en">Paper</skos:prefLabel><skos:prefLabel xml:lang="it">Carta</skos:prefLabel><skos:prefLabel xml:lang="es">Papel</skos:prefLabel><skos:prefLabel xml:lang="et">Paber</skos:prefLabel><skos:prefLabel xml:lang="eu">Paper</skos:prefLabel><skos:prefLabel xml:lang="cs">Papír</skos:prefLabel><skos:prefLabel xml:lang="pl">Papier</skos:prefLabel><skos:prefLabel xml:lang="ro">Hârtie</skos:prefLabel><skos:prefLabel xml:lang="da">Papir</skos:prefLabel><skos:prefLabel xml:lang="nl">Papier</skos:prefLabel><skos:note xml:lang="de">Werkstoff aus Fasern zum Beschreiben, Bedrucken und Verpacken</skos:note><skos:note xml:lang="fi">Ohut kuiduista tehty materiaali</skos:note><skos:note xml:lang="sv">Cellulosabaserat material</skos:note><skos:note xml:lang="ru">Волокнистый материал с минеральными добавками</skos:note><skos:note xml:lang="pt">Folha fina feita com pasta de fibras vegetais</skos:note><skos:note xml:lang="en">Thin, flexible material mainly used for writing upon, printing upon, drawing or for packaging</skos:note><skos:note xml:lang="it">Materiale igroscopico, costituito da materie prime fibrose</skos:note><skos:note xml:lang="fr">Matière fabriquée à partir de fibres cellulosiques végétales et animales</skos:note><skos:note xml:lang="es">Delgada hoja elaborada con pasta de fibras vegetales</skos:note><skos:note xml:lang="cs">Tenký, pružný, vláknitý materiál s minerálními přísadami, vyráběný převážně z celulózy, užívaný pro psaní, kreslení, tisk nebo k balení</skos:note><skos:note xml:lang="sk">Tenký, hladký materiál vyrábaný zhutnením vlákna</skos:note><skos:note xml:lang="pl">Podłoże pisarskie lub malarskie otrzymywane z makulatury, celulozy i włókien innych roślin</skos:note><skos:note xml:lang="da">Materiale man kan skrive og tegne på</skos:note><skos:note xml:lang="nl">Materiaal waarop kan worden geschreven en getekend en dat kan worden bedrukt door middel van een druktechniek</skos:note><skos:note xml:lang="ca">Làmina constituïda per un entramat tridimensional de fibres de cel·lulosa i altres substàncies</skos:note><skos:broader rdf:resource="http://data.europeana.eu/concept/2069"/><skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q11472"/><skos:exactMatch rdf:resource="https://d-nb.info/gnd/4044522-7"/><skos:exactMatch rdf:resource="http://id.loc.gov/authorities/names/sh85097578"/><skos:exactMatch rdf:resource="http://data.bnf.fr/ark:/12148/cb11949744d"/><skos:exactMatch rdf:resource="http://id.ndl.go.jp/auth/ndlna/00564806"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/D010209"/><skos:exactMatch rdf:resource="http://purl.org/bncf/tid/1192"/><skos:exactMatch rdf:resource="https://www.freebase.com/m/0641k"/><skos:exactMatch rdf:resource="https://g.co/kg/m/0641k"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300014109"/><skos:exactMatch rdf:resource="http://iconclass.org/49L641"/><skos:exactMatch rdf:resource="http://www.yso.fi/onto/yso/p8522"/><skos:exactMatch rdf:resource="http://babelnet.org/rdf/s00060464n"/><skos:exactMatch rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10574"/><skos:exactMatch rdf:resource="http://zbw.eu/stw/descriptor/14802-1"/><skos:exactMatch rdf:resource="http://vocabularies.unesco.org/thesaurus/concept14922"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Paper"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_fmb_ms_Michelangelo_M_045_001"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_fmb_ms_Michelangelo_M_045_001"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502183"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.e-codices.unifr.ch/en/list/one/fmb/ms-Michelangelo-M-045-001"/><edm:isShownBy rdf:resource="http://www.e-codices.unifr.ch/loris/fmb/fmb-ms-Michelangelo-M-045-001/fmb-ms-Michelangelo-M-045-001_001.jp2/full/full/0/default.jpg"/><edm:object rdf:resource="http://www.e-codices.unifr.ch/loris/fmb/fmb-ms-Michelangelo-M-045-001/fmb-ms-Michelangelo-M-045-001_001.jp2/full/full/0/default.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671163"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/9200211/en_list_one_fmb_ms_Michelangelo_M_045_001"><dcterms:medium rdf:resource="http://data.europeana.eu/concept/2090"></dcterms:medium><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_fmb_ms_Michelangelo_M_045_001"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_fmb_ms_Michelangelo_M_045_001"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_fmb_ms_Michelangelo_M_045_001"><dc:creator>Michelangelo, Buonarroti</dc:creator><dc:date>undated [1541]</dc:date><dc:description>Michelangelo (1475-1564) addressed this sonnet and his dedication to one of his closest friends, the poet Vittoria Colonna (1492-1547), marchesa of Pescara. Although the painter often was very sparing in his use of paper, for these few lines he used a large and beautiful in-folio sheet, folded and glued together (to add more thickness). Writing in a humanist script close to calligraphy, he showed particular care for the layout, using line spacing and indentations to reinforce the customary architecture of the sonetto. His tone is very respectful: Michelangelo greets not only a friend, but also a lady who is part of high society and who has given him a valuable gift. This gift, which was to take its beneficiary "in paradiso”, must have been a manuscript of the Sonetti spirituali of the poet (who in general was very discreet and only rarely showed her verses).</dc:description><dc:format>1 p., 21.5 x 28.7 cm</dc:format><dc:identifier>doi:10.5076/e-codices-fmb-ms-Michelangelo-M-045-001</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/fmb/ms-Michelangelo-M-045-001</dc:identifier><dc:identifier>Cologny, Fondation Martin Bodmer, M-45.1</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Italian</dc:language><dc:rights>e-codices / Cologny, Fondation Martin Bodmer (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/fmb/ms-Michelangelo-M-045-001"></dc:source><dc:title>Cologny, Fondation Martin Bodmer, M-45.1 : Michelangelo, Sonnet and letter to the poet Vittoria Colonna, autograph</dc:title><dc:type>Autograph</dc:type><dcterms:medium>Paper</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_fmb_ms_Michelangelo_M_045_001"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_fmb_ms_Michelangelo_M_045_001"/><edm:type>TEXT</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_fmb_ms_Michelangelo_M_045_001"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_fmb_ms_Michelangelo_M_045_001"/><edm:datasetName>9200211_Ag_EU_e-Codices</edm:datasetName><edm:country>Switzerland</edm:country><edm:preview rdf:resource="http://www.e-codices.unifr.ch/loris/fmb/fmb-ms-Michelangelo-M-045-001/fmb-ms-Michelangelo-M-045-001_001.jp2/full/full/0/default.jpg"/><edm:landingPage rdf:resource="https://www.europeana.eu/item/9200211/en_list_one_fmb_ms_Michelangelo_M_045_001"/><edm:language>mul</edm:language><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/><edm:completeness>10</edm:completeness><dcterms:created>2016-09-09T12:30:00.329Z</dcterms:created><dcterms:modified>2016-09-27T0