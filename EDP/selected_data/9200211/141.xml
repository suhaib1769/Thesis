:exactMatch rdf:resource="http://www.yso.fi/onto/yso/p11009"/><skos:exactMatch rdf:resource="http://babelnet.org/rdf/s00044453n"/><skos:exactMatch rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8324"/><skos:exactMatch rdf:resource="http://id.loc.gov/authorities/genreForms/gf2022026088"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Manuscript"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_bcj_0010"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bcj_0010"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502183"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.e-codices.unifr.ch/en/list/one/bcj/0010"/><edm:isShownBy rdf:resource="http://www.e-codices.unifr.ch/loris/bcj/bcj-0010/bcj-0010_001r.jp2/full/full/0/default.jpg"/><edm:object rdf:resource="http://www.e-codices.unifr.ch/loris/bcj/bcj-0010/bcj-0010_001r.jp2/full/full/0/default.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671163"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_bcj_0010"><dc:coverage>France</dc:coverage><dc:date>between 1463 and 1498</dc:date><dc:description>15th century Pontifical. The ceremonies are represented as full page miniatures with ornamental initials, marginal decorations and several lines of text on the model of books of hours; in the text there are many colorful borders and ornamental initials, often with depictions of the liturgical objects mentioned in the text. In addition to the frequently recurring coat of arms of Melchior von Lichtenfels, Archbishop of Basel (1554-1575), there is the coat of arms of Charles de Neufchâtel, Archbishop of Besançon (1463-1498; visible on f. 1r), which gives an indication of the manuscript’s date of origin. As many other manuscripts from religious institutions, this manuscript came into the possession of the Jesuit College of Porrentruy during the French Revolution, until in the 20th century it became part of the collection of the Library of the Canton of Jura.</dc:description><dc:format>212 ff., 14.5 x 10 cm</dc:format><dc:identifier>doi:10.5076/e-codices-bcj-0010</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/bcj/0010</dc:identifier><dc:identifier>Porrentruy, Bibliothèque cantonale jurassienne, Ms. 10</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Latin</dc:language><dc:relation>Gamper Rudolf / Jurot Romain, Catalogue des manuscrits médiévaux conservés à Porrentruy et dans le canton du Jura, Dietikon-Zürich 1999, p. 69-72.</dc:relation><dc:rights>e-codices / Porrentruy, Bibliothèque cantonale jurassienne (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/bcj/0010"></dc:source><dc:title>Porrentruy, Bibliothèque cantonale jurassienne, Ms. 10 : Pontifical of Charles de Neufchâtel, Archbishop of Besançon</dc:title><dc:type>Manuscript</dc:type><dcterms:medium>Parchment</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bcj_0010"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_bcj_0010"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/9200211/en_list_one_bcj_0010"><dc:type rdf:resource="http://data.europeana.eu/concept/17"></dc:type><dcterms:medium rdf:resource="http://data.europeana.eu/concept/2092"></dcterms:medium><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bcj_0010"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/