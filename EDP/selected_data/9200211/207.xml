ng="nl">Wastafeltje</skos:prefLabel><skos:prefLabel xml:lang="ca">Tauleta de cera</skos:prefLabel><skos:note xml:lang="cs">Historická psací látka</skos:note><skos:note xml:lang="de">Mit Wachs beschichtete Schreibtafel aus Holz</skos:note><skos:note xml:lang="en">Two  or more tablets of wood, filled with wax, for writing upon</skos:note><skos:note xml:lang="fr">Planchettes recouvertes de cire sur lesquelles on écrit à l'aide d'un stylet/style</skos:note><skos:note xml:lang="ca">Tauleta de fusta coberta amb una capa de cera per escriure-hi</skos:note><skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1428312"/><skos:exactMatch rdf:resource="https://d-nb.info/gnd/4188801-7"/><skos:exactMatch rdf:resource="https://www.freebase.com/m/07cz__"/><skos:exactMatch rdf:resource="https://g.co/kg/m/07cz__"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300192670"/><skos:exactMatch rdf:resource="http://iconclass.org/49L6452"/><skos:exactMatch rdf:resource="http://www.yso.fi/onto/yso/p29633"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Wax_tablet"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_bge_lat0055"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bge_lat0055"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502183"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.e-codices.unifr.ch/en/list/one/bge/lat0055"/><edm:isShownBy rdf:resource="http://www.e-codices.unifr.ch/loris/bge/bge-lat0055/bge-lat0055_004r.jp2/full/full/0/default.jpg"/><edm:object rdf:resource="http://www.e-codices.unifr.ch/loris/bge/bge-lat0055/bge-lat0055_004r.jp2/full/full/0/default.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671163"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_bge_lat0055"><dc:coverage>France</dc:coverage><dc:creator>Lullin, Ami</dc:creator><dc:date>1306-1309</dc:date><dc:description>The Bibliothèque de Genève’s Ms. lat. 55 is an exceptional document because it consists of six wax tablets listing the expenditures for the royal household of the French King Philip IV the Fair for the years 1306-1309.  Over time, the wax turned black and hard, which makes it harder to read. But the images of the tablets are accompanied by a transcription and by a facsimile prepared in 1720-1742 by the Genevan Gabriel Cramer. Preserved as „Ms. lat. 55 bis“, this handwritten facsimile makes it possible to access the content of the tablets and to compare the current state with that of 1720-1742 and thus to recognize the loss of pieces of the wax.</dc:description><dc:format>4 + 6 + 2 ff., 35.8/36 x 15.7/15.8 cm</dc:format><dc:identifier>doi:10.5076/e-codices-bge-lat0055</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/bge/lat0055</dc:identifier><dc:identifier>Genève, Bibliothèque de Genève, Ms. lat. 55</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Latin</dc:language><dc:relation>Notive de Isabelle Jeger, Bibliothèque de Genève, 2015.</dc:relation><dc:rights>e-codices / Genève, Bibliothèque de Genève (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/bge/lat0055"></dc:source><dc:title>Genève, Bibliothèque de Genève, Ms. lat. 55 : Record of expenditures for the &lt;i>Hôtel&lt;/i> of Philip IV the Fair, King of France, for the years 1306-1309, written on wax tablets</dc:title><dc:type>Tablets</dc:type><dcterms:medium>Wood and wax</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bge_lat0055"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9