oxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bge_gr0044"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_bge_gr0044"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_bge_gr0044"><dc:coverage>Constantinople</dc:coverage><dc:creator>Homerus</dc:creator><dc:date>13th century</dc:date><dc:description>This 13th century Byzantine manuscript contains a great number of scholia, which partially complete those of older manuscripts and which testify to the environment during production and to the habits of the manuscript’s annotators and successive owners. To be distinguished among these are Theodorus Meliteniota, who restored and completed the already damaged manuscript in the 14th century, as well as Henri Estienne (Henricus Stephanus), who owned the manuscript in the second half of the 16th century and used it for his 1566 edition of Homer’s poems, which remained the standard into the 18th century. With the exception of several accidental short lacunas or gaps, the manuscript contains a complete Iliad, including an interlinear paraphrase for the first twelve books.</dc:description><dc:format>12 + 802 pp., 30.2 x 21.5 cm</dc:format><dc:identifier>doi:10.5076/e-codices-bge-gr0044</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/bge/gr0044</dc:identifier><dc:identifier>Genève, Bibliothèque de Genève, Ms. gr. 44</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Ancient Greek</dc:language><dc:relation>Notice d’André-Louis Rey, Bibliothèque de Genève et Université de Genève, pour e-codices 2013 (analyse de la composition des cahiers par Andrea Giovannini et André-Louis Rey) ; étude détaillée en cours.</dc:relation><dc:rights>e-codices / Genève, Bibliothèque de Genève (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/bge/gr0044"></dc:source><dc:title>Genève, Bibliothèque de Genève, Ms. gr. 44 : Homer, Iliad with scholia and an interlinear paraphrase of Books I to XII</dc:title><dc:type>Manuscript</dc:type><dcterms:medium>Paper</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bge_gr0044"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_bge_gr0044"/><edm:type>TEXT</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_bge_gr0044"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bge_gr0044"/><edm:datasetName>9200211_Ag_EU_e-Codices</edm:datasetName><edm:country>Switzerland</edm:country><edm:preview rdf:resource="http://www.e-codices.unifr.ch/loris/bge/bge-gr0044/bge-gr0044_001.jp2/full/full/0/default.jpg"/><edm:landingPage rdf:resource="https://www.europeana.eu/item/9200211/en_list_one_bge_gr0044"/><edm:language>mul</edm:language><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/><edm:completeness>10</edm:completeness><dcterms:created>2016-09-09T12:18:29.974Z</dcterms:created><dcterms:modified>2016-09-27T09:29:54.244Z</dcterms:modified><dqv:hasQualityAnnotation rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bge_gr0044#contentTier"/><dqv:hasQualityAnnotation rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bge_gr0044#metadataTier"/></edm:EuropeanaAggregation><foaf:Organization rdf:about="http://data.europeana.eu/organization/1482250000004671163"><skos:prefLabel xml:lang="en">University of Fribourg</skos:prefLabel></foaf:Organization><foaf:Organization rdf:about="http://data.europeana.eu/organization/1482250000004502183"><skos:prefLabel xml:lang="en">E-codices - Virtual Manuscript Library of Switzerland</skos:prefLabel>