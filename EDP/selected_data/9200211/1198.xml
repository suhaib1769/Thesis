df:resource="https://www.freebase.com/m/04vf8"/><skos:exactMatch rdf:resource="https://g.co/kg/m/04vf8"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/V02.630"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/L01.178.682.608"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300028569"/><skos:exactMatch rdf:resource="http://www.yso.fi/onto/yso/p11009"/><skos:exactMatch rdf:resource="http://babelnet.org/rdf/s00044453n"/><skos:exactMatch rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8324"/><skos:exactMatch rdf:resource="http://id.loc.gov/authorities/genreForms/gf2022026088"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Manuscript"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_sbb_C0014"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_sbb_C0014"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502183"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.e-codices.unifr.ch/en/list/one/sbb/C0014"/><edm:isShownBy rdf:resource="http://www.e-codices.unifr.ch/loris/sbb/sbb-C0014/sbb-C0014_001r.jp2/full/full/0/default.jpg"/><edm:object rdf:resource="http://www.e-codices.unifr.ch/loris/sbb/sbb-C0014/sbb-C0014_001r.jp2/full/full/0/default.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671163"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_sbb_C0014"><dc:coverage>Beromünster</dc:coverage><dc:creator>Augustinus, Aurelius</dc:creator><dc:creator>Bonaventura, Sanctus</dc:creator><dc:creator>Henricus, de Langenstein</dc:creator><dc:creator>Jacobus, de Cessolis</dc:creator><dc:creator>Johannes, Gerson</dc:creator><dc:creator>Aristoteles</dc:creator><dc:creator>Solinus, Gaius Julius</dc:creator><dc:creator>Thomas, de Cantiprato</dc:creator><dc:date>second half of the 14th century / 15th century</dc:date><dc:description>Composite manuscript of catechetical-ascetic content, in quarto format on paper. Three fascicles of various strengths. The oldest is from the second half of the 14th century; it is written by Albert von Münnerstadt, Conventual from the Commandry of the Teutonic Knights of Hitzkirch, and contains Moralitates super evangelium sancti Lucae. In the second half of the 15th century, probably in Beromünster, this was bound together with two natural science Compendia moralia (excerpts from Thomas of Cantimpré’s encyclopedia) and with catechetical treatises by Heinrich von Langenstein, Johannes Gerson and Bonaventure. Scholarly manuscript for regular use in the area of pastoral care (hasty hand with numerous abbreviations, especially in the third fascicle).</dc:description><dc:format>265 ff., 21 x 15 cm</dc:format><dc:identifier>doi:10.5076/e-codices-sbb-C0014</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/sbb/C0014</dc:identifier><dc:identifier>Beromünster, Stiftskirche St. Michael, Ms. C 14</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Latin</dc:language><dc:language>German</dc:language><dc:relation>Beschreibung von Eckart Conrad Lutz (Universität Freiburg-Schweiz) für e-codices, 2014.</dc:relation><dc:rights>e-codices / Beromünster, Stiftskirche St. Michael (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/sbb/C0014"></dc:source><dc:title>Beromünster, Stiftskirche St. Michael, Ms. C 14 : &lt;i>Compendium morale de avibus / de quadrupedibus&lt;/i> – Heinrich von Langenstein, &lt;i>De discretione spiritum&lt;/i> – Johannes Gerson, &lt;i>Opus tripartitum de praeceptis Decalogi, de confessione, et de arte moriendi&lt;/i> – Bonaventura, &lt;i>De praeparatione ad m</dc:title><dc:type>Manuscript</dc:type