iversity library of Tübingen (Mm I 7).</dc:description><dc:format>4 pp., 15.5 x 10.5 cm</dc:format><dc:identifier>doi:10.5076/e-codices-bks-Fragm-I-0001</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/bks/Fragm-I-0001</dc:identifier><dc:identifier>Sarnen, Benediktinerkollegium, Fragm. I. 1</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Latin</dc:language><dc:relation>Bretscher-Gisiger Charlotte / Gamper Rudolf, Katalog der mittelalterlichen Handschriften der Klöster Muri und Hermetschwil, Dietikon-Zürich 2005, S. 362.</dc:relation><dc:rights>e-codices / Sarnen, Benediktinerkollegium (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/bks/Fragm-I-0001"></dc:source><dc:title>Sarnen, Benediktinerkollegium, Fragm. I. 1 : Liber traditionum fuldensis</dc:title><dc:type>Fragment</dc:type><dcterms:medium>Parchment</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bks_Fragm_I_0001"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_bks_Fragm_I_0001"/><edm:type>TEXT</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/9200211/en_list_one_bks_Fragm_I_0001"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_bks_Fragm_I_0001"/><edm:datasetName>9200211_Ag_EU_e-Codices</edm:datasetName><edm:country>Switzerland</edm:country><edm:preview rdf:resource="http://www.e-codices.unifr.ch/loris/bks/bks-Fragm-I-0001/bks-Fragm-I-0001_002_003.jp2/full/full/0/default.jpg"/><edm:landingPage rdf:resource="https://www.europeana.eu/item/9200211/en_list_one_bks_Fragm_I_0001"/><edm:language>mul</edm:language><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/><edm:completeness>10</edm:completeness><dcte