ce="https://d-nb.info/gnd/4126273-6"/><skos:exactMatch rdf:resource="http://id.loc.gov/authorities/names/sh85080672"/><skos:exactMatch rdf:resource="http://id.ndl.go.jp/auth/ndlna/00571802"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/D020486"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/D008373"/><skos:exactMatch rdf:resource="http://purl.org/bncf/tid/1879"/><skos:exactMatch rdf:resource="https://www.freebase.com/m/04vf8"/><skos:exactMatch rdf:resource="https://g.co/kg/m/04vf8"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/V02.630"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/L01.178.682.608"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300028569"/><skos:exactMatch rdf:resource="http://www.yso.fi/onto/yso/p11009"/><skos:exactMatch rdf:resource="http://babelnet.org/rdf/s00044453n"/><skos:exactMatch rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8324"/><skos:exactMatch rdf:resource="http://id.loc.gov/authorities/genreForms/gf2022026088"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Manuscript"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/9200211/en_list_one_csg_0869"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_0869"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004502183"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.e-codices.unifr.ch/en/list/one/csg/0869"/><edm:isShownBy rdf:resource="http://www.e-codices.unifr.ch/loris/csg/csg-0869/csg-0869_002.jp2/full/full/0/default.jpg"/><edm:object rdf:resource="http://www.e-codices.unifr.ch/loris/csg/csg-0869/csg-0869_002.jp2/full/full/0/default.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671163"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc/3.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/9200211/en_list_one_csg_0869"><dc:coverage>St. Gall</dc:coverage><dc:creator>Walahfridus, Strabo</dc:creator><dc:date>second half of the 9th century</dc:date><dc:description>A highly important poetry manuscript containing the works of the Reichenau scholar and Abbot Walahfrid Strabo (809/10-849). In addition to a wealth of short poems of both a spiritual and a worldly nature, the volume also includes verse legends about both the Cappadocian martyr Mammes (De vita et fine Mammae monachi) and the Irish Abbot Blathmac (Versus Strabi de beati Blaithmaic vita et fine), the Dream-vision of Reichenau monk Wetti (Visio Wettini) and the poem De imagine Tetrici, a discussion of the now lost statue of Theoderich the Great on horseback, which Charlemagne had moved from Ravenna to his palace in Aachen. The manuscript was produced in the Abbey of St. Gall during the second half of the 9th century.</dc:description><dc:format>260 ff., 16.5 x 13 cm</dc:format><dc:identifier>doi:10.5076/e-codices-csg-0869</dc:identifier><dc:identifier>http://www.e-codices.unifr.ch/en/list/one/csg/0869</dc:identifier><dc:identifier>St. Gallen, Stiftsbibliothek, Cod. Sang. 869</dc:identifier><dc:publisher>e-codices - Virtual Manuscript Library of Switzerland</dc:publisher><dc:language>Latin</dc:language><dc:relation>Scherrer Gustav, Verzeichniss der Handschriften der Stiftsbibliothek von St. Gallen, Halle 1875, S. 300.</dc:relation><dc:rights>e-codices / St. Gallen, Stiftsbibliothek (cf. http://www.e-codices.unifr.ch/en/about/terms)</dc:rights><dc:source rdf:resource="http://www.e-codices.unifr.ch/en/list/one/csg/0869"></dc:source><dc:title>St. Gallen, Stiftsbibliothek, Cod. Sang. 869 : Poetry manuscript containing the works of the Reichenau scholar and Abbot Walahfrid Strabo</dc:title><dc:type>Manuscript</dc:type><dcterms:medium>Parchment</dcterms:medium><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/9200211/en_list_one_csg_0869"/><ore:p