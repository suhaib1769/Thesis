Schema#hexBinary">#F0F8FF</edm:componentColor><edm:componentColor rdf:datatype="http://www.w3.org/2001/XMLSchema#hexBinary">#FFB6C1</edm:componentColor><ebucore:orientation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portrait</ebucore:orientation></edm:WebResource><edm:TimeSpan rdf:about="#1984"><skos:prefLabel xml:lang="zxx">1984</skos:prefLabel><dcterms:isPartOf rdf:resource="http://data.europeana.eu/timespan/20"></dcterms:isPartOf><edm:begin>1984-01-01</edm:begin><edm:end>1984-12-31</edm:end></edm:TimeSpan><skos:Concept rdf:about="http://data.europeana.eu/concept/122"><skos:prefLabel xml:lang="de">Feminismus</skos:prefLabel><skos:prefLabel xml:lang="ru">Феминизм</skos:prefLabel><skos:prefLabel xml:lang="fi">Feminismi</skos:prefLabel><skos:prefLabel xml:lang="pt">Feminismo</skos:prefLabel><skos:prefLabel xml:lang="bg">Феминизъм</skos:prefLabel><skos:prefLabel xml:lang="lt">Feminizmas</skos:prefLabel><skos:prefLabel xml:lang="lv">Feminisms</skos:prefLabel><skos:prefLabel xml:lang="hr">Feminizam</skos:prefLabel><skos:prefLabel xml:lang="fr">Féminisme</skos:prefLabel><skos:prefLabel xml:lang="hu">Feminizmus</skos:prefLabel><skos:prefLabel xml:lang="sk">Feminizmus</skos:prefLabel><skos:prefLabel xml:lang="sl">Feminizem</skos:prefLabel><skos:prefLabel xml:lang="ga">Feimineachas</skos:prefLabel><skos:prefLabel xml:lang="ca">Feminisme</skos:prefLabel><skos:prefLabel xml:lang="sv">Feminism</skos:prefLabel><skos:prefLabel xml:lang="mt">Femminiżmu</skos:prefLabel><skos:prefLabel xml:lang="el">Φεμινισμός</skos:prefLabel><skos:prefLabel xml:lang="en">Feminism</skos:prefLabel><skos:prefLabel xml:lang="it">Femminismo</skos:prefLabel><skos:prefLabel xml:lang="es">Feminismo</skos:prefLabel><skos:prefLabel xml:lang="et">Feminism</skos:prefLabel><skos:prefLabel xml:lang="eu">Feminismo</skos:prefLabel><skos:prefLabel xml:lang="cs">Feminismus</skos:prefLabel><skos:prefLabel xml:lang="pl">Feminizm</skos:prefLabel><skos:prefLabel xml:lang="ro">Feminism</skos:prefLabel><skos:prefLabel xml:lang="da">Feminisme</skos:prefLabel><skos:prefLabel xml:lang="nl">Feminisme</skos:prefLabel><skos:note xml:lang="de">Bewegungen mit dem Ziel, Gleichberechtigung von Frauen herzustellen und zu verteidigen</skos:note><skos:note xml:lang="sv">Samling rörelser och ideologier vars målsättning är att kvinnor ska ha samma rättigheter och möjligheter som män</skos:note><skos:note xml:lang="ru">Спектр идеологий прав направленных на достижение равенств обоих полов</skos:note><skos:note xml:lang="fi">Liike ja suuntaus, joka tavoittelee sukupuolten välistä tasa-arvoa</skos:note><skos:note xml:lang="pt">Movimentos e ideologias que visam estabelecer a igualdade de gênero</skos:note><skos:note xml:lang="el">Ιδεολογία</skos:note><skos:note xml:lang="mt">Ġabra ta’ movimenti u ideoloġiji bl-għan li jiddefinixxu, jistabbilixxu u jiddefendu l-ugwaljanza bejn in-nisa u l-irġiel, inkluż drittijiet ugwali għan-nisa u għall-bniet</skos:note><skos:note xml:lang="lt">Ideologinis judėjimas apibrėžiantis lyčių lygybę ir kovojantis už moterų ir merginų lygias teises.</skos:note><skos:note xml:lang="en">Group of movements that come about defining, and defending gender equity, including equal rights for women and girls</skos:note><skos:note xml:lang="lv">Ideoloģiju un kustību kopums, kas aizstāv principu, ka sievietes un vīrieši ir tiesībās vienlīdzīgi cilvēki</skos:note><skos:note xml:lang="hr">Radikalna ideologija čiji je cilj jačanje žena u društvu</skos:note><skos:note xml:lang="it">Movimento complesso ed eterogeneo, che si è sviluppato con caratteristiche peculiari in ogni paese ed epoca</skos:note><skos:note xml:lang="fr">Ensemble d'idées politiques, philosophiques et sociales cherchant à promouvoir les droits des femmes et leurs intérêts dans la société civile</skos:note><skos:note xml:lang="hu">Olyan politikai ideológiák és emberi jogi mozgalmak gyűjtőfogalma, melynek közös célja a nemek közti egyenlőség meghatározása, biztosítása és védelme</skos:note><skos:note xml:lang="es">Teoría y conjunto de movimientos sociales y políticos que luchan por la igualdad de género</skos:note><skos:note xml:lang="eu">Mugimendu eta ideologien bilduma, helburutzat duena genero arteko berdintasuna definitzea, ezartzea eta aldeztea, emakumeentzako eskubide berdintasuna barne</skos:note><skos:note xml:lang="cs">Spektrum ideologií, politických a sociálních hnutí, která si kladou za cíl definovat, zkoumat a dosáhnout politické, ekonomické a sociální rovnosti žen a mužů</skos:note><skos:note xml:lang="pl">Ruch emancypacji kobiet</skos:note><skos:note xml:lang="ro">Culegere de mișcări și ideologii care vizează definirea, stabilirea și apărarea egalității de gen, inclusiv drepturi egale pentru femei și fete</skos:note><skos:note xml:lang="da">Samling af bevægelser og ideologier, hvis formål er, at kvinder bør have samme rettigheder, muligheder og forpligtelser som mænd</skos:note><skos:note xml:lang="nl">Een geheel van politieke, filosofische en sociale ideeën en bewegingen die gericht zijn op de gelijkberechtiging van verschillende genders, waaronder vrouwen en meisjes.</skos:note><skos:note xml:lang="ca">El conjunt del moviment feminista i la teoria feminista</skos:note><skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7252"/><skos:exactMatch rdf:resource="https://d-nb.info/gnd/4222126-2"/><skos:exactMatch rdf:resource="http://id.loc.gov/authorities/names/sh85047741"/><skos:exactMatch rdf:resource="http://data.bnf.fr/ark:/12148/cb11938848m"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/D019513"/><skos:exactMatch rdf:resource="http://purl.org/bncf/tid/9485"/><skos:exactMatch rdf:resource="https://www.freebase.com/m/02_h0"/><skos:exactMatch rdf:resource="https://g.co/kg/m/02_h0"/><skos:exactMatch rdf:resource="http://datos.bne.es/resource/XX525610"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300055786"/><skos:exactMatch rdf:resource="http://www.yso.fi/onto/yso/p7254"/><skos:exactMatch rdf:resource="http://babelnet.org/rdf/s00034034n"/><skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y104960"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Feminism"/><skos:related rdf:resource="http://data.europeana.eu/concept/125"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/618/https___ihlia_nl_search_index_jsp_q_3Asearch_ID_T0272"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/618/https___ihlia_nl_search_index_jsp_q_3Asearch_ID_T0272"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000027227898"></edm:dataProvider><edm:isShownBy rdf:resource="https://collectie.atria.nl/i/?IIIF=/23/f0/a5/bb/23f0a5bb-4e64-4c8d-b5c1-000a7f769820/iiif/T0272_1.tif/full/max/0/default.jpg"/><edm:object rdf:resource="https://collectie.atria.nl/i/?IIIF=/23/f0/a5/bb/23f0a5bb-4e64-4c8d-b5c1-000a7f769820/iiif/T0272_1.tif/full/max/0/default.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671093"></edm:provider><edm:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/618/https___ihlia_nl_search_index_jsp_q_3Asearch_ID_T0272"><dc:date>1984</dc:date><dc:description xml:lang="nl">Wit t-shirt met tekst: 'we sell our labour not our rights. women's information centre thailand'. Afbeelding van vrouwengelaat en profil in wit vak. Daaronder Thaise tekst.</dc:description><dc:identifier>T0272</dc:identifier><dc:language>English</dc:language><dc:rights>In copyright (visible)</dc:rights><dc:subject xml:lang="nl">vrouwenemancipatie</dc:subject><dc:subject xml:lang="nl">vrouwen</dc:subject><dc:subject xml:lang="nl">feminisme</dc:subject><dc:subject xml:lang="nl">thailand</dc:subject><dc:title>T-shirt 'We sell our labour not our rights'</dc:title><dc:type>Textile/Textiel</dc:type><dcterms:isPartOf>Gender Heritage Connection</dcterms:isPartOf><dcterms:spatial>thailand</dcterms:spatial><edm:europeanaProxy>