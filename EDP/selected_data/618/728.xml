Produced by Southern Gay Health Project'. Aan de binnenkant staat een uitleg over hoe het condoom omgedaan moet worden met daaronder drie foto's van stijve piemels waar stapsgewijs het condoom bij wordt omgedaan.</dc:description><dc:identifier>M01010</dc:identifier><dc:language>English</dc:language><dc:rights>In copyright (visible)</dc:rights><dc:subject xml:lang="nl">hiv/aids</dc:subject><dc:subject xml:lang="nl">homomannen</dc:subject><dc:subject xml:lang="nl">veilig vrijen</dc:subject><dc:subject xml:lang="nl">ierland</dc:subject><dc:title>Condoomverpakking 'Shag Pack'</dc:title><dc:type>Object/Object</dc:type><dcterms:isPartOf>Gender Heritage Connection</dcterms:isPartOf><dcterms:spatial>cork</dcterms:spatial><dcterms:spatial>ierland</dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/618/https___ihlia_nl_search_index_jsp_q_3Asearch_ID_M01010"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/618/https___ihlia_nl_search_index_jsp_q_3Asearch_ID_M01010"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/618/https___ihlia_nl_search_index_jsp_q_3Asearch_ID_M01010"><dc:date rdf:resource="#1985%2F2000"></dc:date><dc:identifier>https://ihlia.nl/search/index.jsp?q%3Asearch=ID:M01010</dc:identifier><dc:language>eng</dc:language><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/618/https___ihlia_nl_search_index_jsp_q_3Asearch_ID_M01010"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/618/https___ihlia_nl_search_index_jsp_q_3Asearch_ID_M01010"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/provider/618/https___ihlia_nl_search_index_jsp_q_3Asearch_ID_M01010"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/618/https___ihlia_nl_search_index_jsp_q_3Asearch_ID_M01010"><edm