lang="pt">Discriminação</skos:prefLabel><skos:prefLabel xml:lang="bg">Дискриминация</skos:prefLabel><skos:prefLabel xml:lang="lt">Diskriminacija</skos:prefLabel><skos:prefLabel xml:lang="lv">Diskriminācija</skos:prefLabel><skos:prefLabel xml:lang="hr">Diskriminacija</skos:prefLabel><skos:prefLabel xml:lang="fr">Discrimination</skos:prefLabel><skos:prefLabel xml:lang="hu">Diszkrimináció</skos:prefLabel><skos:prefLabel xml:lang="sk">Diskriminácia</skos:prefLabel><skos:prefLabel xml:lang="sl">Diskriminacija</skos:prefLabel><skos:prefLabel xml:lang="ga">Idirdhealú</skos:prefLabel><skos:prefLabel xml:lang="ca">Discriminació</skos:prefLabel><skos:prefLabel xml:lang="sv">Diskriminering</skos:prefLabel><skos:prefLabel xml:lang="el">Διάκριση</skos:prefLabel><skos:prefLabel xml:lang="en">Discrimination</skos:prefLabel><skos:prefLabel xml:lang="it">Discriminazione</skos:prefLabel><skos:prefLabel xml:lang="es">Discriminación</skos:prefLabel><skos:prefLabel xml:lang="et">Diskrimineerimine</skos:prefLabel><skos:prefLabel xml:lang="cs">Diskriminace</skos:prefLabel><skos:prefLabel xml:lang="eu">Diskriminazio</skos:prefLabel><skos:prefLabel xml:lang="pl">Dyskryminacja</skos:prefLabel><skos:prefLabel xml:lang="ro">Discriminare</skos:prefLabel><skos:prefLabel xml:lang="da">Diskrimination</skos:prefLabel><skos:prefLabel xml:lang="nl">Discriminatie</skos:prefLabel><skos:note xml:lang="de">Verhalten gegenüber einer bestimmten Gruppe von Menschen</skos:note><skos:note xml:lang="ru">Ущемление прав человека</skos:note><skos:note xml:lang="fi">Yksilön tai ryhmän systemaattinen torjuminen tai asettaminen muita huonompaan asemaan</skos:note><skos:note xml:lang="sv">Åtskillnad mellan olika människor som inte bygger på meriter eller talanger</skos:note><skos:note xml:lang="el">Προκατειλημμένη μεταχείριση με βάση του ανήκειν σε μια συγκεκριμένη ομάδα</skos:note><skos:note xml:lang="en">Prejudicial treatment based on membership of a certain group</skos:note><skos:note xml:lang="it">Termine</skos:note><skos:note xml:lang="fr">Comportement à l'égard d'un groupe spécifique de personnes</skos:note><skos:note xml:lang="es">Trato perjudicial basado en la pertenencia a un determinado grupo</skos:note><skos:note xml:lang="cs">Předsudečné rozlišování na základě příslušnosti k nějaké skupině</skos:note><skos:note xml:lang="sk">Rozlišovanie, znevýhodnenie, rozdielny prístup k rôznym skupinám</skos:note><skos:note xml:lang="pl">Gorsze traktowanie kogoś ze względu na przynależność danej osoby do określonej grupy</skos:note><skos:note xml:lang="da">Diskrimination er, når en person eller gruppe af mennesker skelner mellem folk der ikke er baseret på fortjeneste eller talent</skos:note><skos:note xml:lang="ro">Tratare pe criterii de apartenență la un anumit grup</skos:note><skos:note xml:lang="nl">Het onrechtmatig onderscheid maken tussen mensen of groepen</skos:note><skos:broader rdf:resource="http://data.europeana.eu/concept/3385"/><skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q169207"/><skos:exactMatch rdf:resource="https://d-nb.info/gnd/4012472-1"/><skos:exactMatch rdf:resource="http://id.loc.gov/authorities/names/sh85038376"/><skos:exactMatch rdf:resource="http://data.bnf.fr/ark:/12148/cb13319080z"/><skos:exactMatch rdf:resource="http://www.idref.fr/027803465/id"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/D063508"/><skos:exactMatch rdf:resource="http://purl.org/bncf/tid/31892"/><skos:exactMatch rdf:resource="https://www.freebase.com/m/02gg2"/><skos:exactMatch rdf:resource="https://g.co/kg/m/02gg2"/><skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/F01.145.813.629"/><skos:exactMatch rdf:resource="http://datos.bne.es/resource/XX525409"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300055301"/><skos:exactMatch rdf:resource="http://id.worldcat.org/fast/894985"/><skos:exactMatch rdf:resource="http://www.yso.fi/onto/yso/p6303"/><skos:exactMatch rdf:resource="http://babelnet.org/rdf/s00027538n"/><skos:exactMatch rdf:resourc