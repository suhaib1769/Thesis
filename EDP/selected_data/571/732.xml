ng="zxx">1798</skos:prefLabel><dcterms:isPartOf rdf:resource="http://data.europeana.eu/timespan/18"></dcterms:isPartOf><edm:begin>1798-01-01</edm:begin><edm:end>1798-12-31</edm:end></edm:TimeSpan><skos:Concept rdf:about="https://hispana.mcu.es/lod/oai:fondohistorico.cortesaragon.es:259#ent7"><skos:prefLabel xml:lang="es">Aragón (Reino)-Mapas generales-1798</skos:prefLabel><skos:broader rdf:resource="https://hispana.mcu.es/lod/oai:fondohistorico.cortesaragon.es:259#ent10"/><skos:closeMatch rdf:resource="https://www.cortesaragon.es/fondoHistorico/aut/FDHA20140000845"/></skos:Concept><skos:Concept rdf:about="https://hispana.mcu.es/lod/oai:fondohistorico.cortesaragon.es:259#ent8"><skos:prefLabel xml:lang="es">Aragón (Reino)-Mapas eclesiásticos-1798</skos:prefLabel><skos:broader rdf:resource="https://hispana.mcu.es/lod/oai:fondohistorico.cortesaragon.es:259#ent10"/><skos:closeMatch rdf:resource="https://www.cortesaragon.es/fondoHistorico/aut/FDHA20140000869"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/571/https___hispana_mcu_es_lod_oai_fondohistorico_cortesaragon_es_259_ent0"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/571/https___hispana_mcu_es_lod_oai_fondohistorico_cortesaragon_es_259_ent0"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000004503496"></edm:dataProvider><edm:isShownAt rdf:resource="https://www.cortesaragon.es/fondoHistorico/es/consulta/registro.do?id=259"/><edm:isShownBy rdf:resource="https://www.cortesaragon.es/fondoHistorico/i18n/catalogo_imagenes/imagen_id.do?idImagen=33139"/><edm:object rdf:resource="https://www.cortesaragon.es/fondoHistorico/i18n/catalogo_imagenes/imagen_id.do?idImagen=33139"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000004671126"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by-nc-nd/4.0/"/></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/571/https___hispana_mcu_es_lod_oai_fondohistorico_cortesaragon_es_259_ent0"><dc:date rdf:resource="#1798"></dc:date><dc:date rdf:resource="#1798"></dc:date><dc:date xml:lang="zxx">1798</dc:date><dc:description xml:lang="en">Small explanatory notes distributed by the map</dc:description><dc:description xml:lang="en">Scale also expressed in leagues of one hour or 20 to the grade, legal leagues of 26 ½ to the grade and geographical leagues of 15 to the grade</dc:description><dc:description xml:lang="en">Graduate margins. - Drawn meridians and parallels forming grid. - Eastern length of Iron Island. - Relief by profile mounts and shading. - Hydrographic network and roads. - Treated. - Cities represented by sets of buildings according to their importance. - Key of symbols indicating cities, villas, sales, university, ducats, boundaries of corregimientos and bishops, roads, etc. - Administrative divisions differentiated by color. - Legend, scales and toponymy in Spanish</dc:description><dc:description xml:lang="en">Map made by Franz Ludwig Güssefeld, based on the information provided by Tomás López and published in the atlases edited by Homann’s Heirs.</dc:description><dc:description xml:lang="en">In the lower right angle is the title in cartela with Renaissance frame on a base decorated with religious motifs and crowned by a calyx.</dc:description><dc:identifier>https://hispana.mcu.es/lod/oai:fondohistorico.cortesaragon.es:259#ent0</dc:identifier><dc:publisher xml:lang="en">Homanniani Haeredes ederunt... Cum Gratia &amp; Privil. Sa. Caes. Maj.</dc:publisher><dc:publisher xml:lang="es">Homanniani Haeredes ederunt... Cum Gratia &amp; Privil. Sa. Caes. Maj.</dc:publisher><dc:language>mul</dc:language><dc:rights xml:lang="en">The dissemination of descriptive information and digital images of this document has been authorized by the Cortes de Aragón exclusively for private use and for teaching and research activities. In no case is authorized its reproduction with lucrative purpose nor its distribution, public communication and transformation by any means without express and written authorization of the Cortes de Aragón. - http://creativecommons.org/-/by-nc-nd/4.0 /</dc:rights><dc:subject xml:lang="en">Aragon (Kingdom) -General Maps - 1798</dc:subject><dc:subject xml:lang="en">Aragon (Kingdom) -Church Maps -1798</dc:subject><dc:type xml:lang="en">Maps</dc:type><dcterms:isReferencedBy xml:lang="en">References: Hernando, Augustine. The image of a country: Juan Bautista Labaña and his map of Aragón (1610-1620). Zaragoza: Institution Fernando El Católica, 1996, p.110</dcterms:isReferencedBy><dcterms:issued rdf:resource="#1798"></dcterms:issued><dcterms:issued rdf:resource="#1798"></dcterms:issued><dcterms:issued xml:lang="zxx">1798</dcterms:issued><dcterms:spatial xml:lang="en">Aragon (Kingdom) -General Maps - 1798</dcterms:spatial><dcterms:spatial xml:lang="en">Aragon (Kingdom) -Church Maps -1798</dcterms:spatial><dcterms:spatial xml:lang="en">Germany-Nuremberg</dcterms:spatial><dcterms:temporal rdf:resource="#1798"></dcterms:temporal><dcterms:temporal rdf:resource="#1798"></dcterms:temporal><dcterms:temporal rdf:resource="#1798"></dcterms:temporal><dcterms:temporal rdf:resource="#1798"></dcterms:temporal><dcterms:temporal xml:lang="en">1798</dcterms:temporal><edm:currentLocation xml:lang="en">Cortes Aragón Library</edm:currentLocation><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1798</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/571/https___hispana_mcu_es_lod_oai_fondohistorico_cortesaragon_es_259_ent0"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/571/https___hispana_mcu_es_lod_oai_fondohistorico_cortesaragon_es_259_ent0"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/provider/571/https___hispana_mcu_es_lod_oai_fondohistorico_cortesaragon_es_259_ent0"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/571/https___hispana_mcu_es_lod_oai_fondohistorico_cortesaragon_es_259_ent0"><dc:creator rdf:resource="https://hispana.mcu.es/lod/oai:fondohistorico.cortesaragon.es:259#ent3"></dc:creator><dc:creator rdf:resource="https://hispana.mcu.es/lod/oai:fondohistorico.cortesaragon.es:259#ent4"></dc:creator><dc:creator rdf:resource="https://hispana.mcu.es/lod/oai:fondohistorico.cortesaragon.es:259#ent5"></dc:creator><dc:creator rdf:resource="https://hispana.mcu.es/lod/oai:fondohistorico.cortesaragon.es:259#ent6"></dc:creator><dc:date>1798</dc:date><dc:description xml:lang="es">En el margen superior consta : "Charte geographique du Royaume de Aragon, selon les memoires du Mons. Tom Lopez dressée nouvellement par F.L. Gussefeld &amp; publiée par les Heret. du seu M. Homan á Nurembereg l' an 1798"</dc:description><dc:description xml:lang="es">Pequeñas notas explicativas distribuidas por el mapa</dc:description><dc:description xml:lang="es">Escala también expresada en leguas de una hora o de 20 al grado, leguas legales castellanas de 26 ½ al grado y leguas geográficas de 15 al grado</dc:description><dc:description xml:lang="es">Copia digital : Fondo Documental Histórico (Cortes Aragón)</dc:description><dc:description xml:lang="es">Márgenes graduados. - Dibujados meridianos y paralelos formando cuadrícula. - Longitud oriental de la Isla de Hierro. - Relieve por montes de perfil y sombreado. - Red hidrográfica y de caminos. - Arbolado. - Ciudades representadas por conjuntos de edificaciones según su importancia. - Clave de símbolos indicando ciudades, villas, ventas, universidad, ducados, límites de corregimientos y obispados, caminos, etc. - Divisiones administrativas diferenciadas por color. - Leyenda, escalas y toponimia en español</dc:description><dc:description xml:lang="es">Mapa realizado por Franz Ludwig Güssefeld, basado en la información proporcionada por Tomás López y publicado en los atlas editados por los Herederos de Homann</dc:description><dc:description xml:lang="es">En el ángulo infer