client
dev tun
tun-mtu 1500
proto tcp
remote 178.62.250.193 443
resolv-retry infinite
nobind
persist-tun
persist-key
auth-nocache
ca ca.crt
cert sbasir.crt
key sbasir.key
tls-auth ta.key 1
remote-cert-tls server
cipher AES-256-GCM
data-ciphers AES-256-GCM
tls-client
tls-version-min 1.2
topology subnet
script-security 1
verb 3
compress lz4-v2
